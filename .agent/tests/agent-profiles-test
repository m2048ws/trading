#!/usr/bin/env python3

import json
import pathlib
import tomllib


ROOT = pathlib.Path(__file__).resolve().parents[2]
POLICY = json.loads((ROOT / ".agent" / "worker-roles.json").read_text())
EXPECTED = {
    "exploration": "openspec-exploration.toml",
    "apply": "openspec-apply.toml",
    "remediate": "openspec-remediation.toml",
    "finalize": "openspec-finalization.toml",
}


for role_name, filename in EXPECTED.items():
    path = ROOT / ".codex" / "agents" / filename
    with path.open("rb") as stream:
        profile = tomllib.load(stream)

    for required in ("name", "description", "developer_instructions"):
        value = profile.get(required)
        assert isinstance(value, str) and value.strip(), (
            f"{filename} is missing {required}"
        )

    role = POLICY["roles"][role_name]
    assert profile["name"] == role["agent_profile"]
    assert profile["model"] == role["model"]
    assert profile["model_reasoning_effort"] == role["reasoning_effort"]

    instructions = profile["developer_instructions"]
    assert "{{" not in instructions
    if role["formal"]:
        if role["native_eligible"]:
            assert "rendered" in instructions.lower()
            assert "report" in instructions.lower()
            assert profile["sandbox_mode"] == "workspace-write"
        else:
            assert profile["sandbox_mode"] == "read-only"
            assert "ineligible" in instructions.lower()
            assert "script backend" in instructions.lower()
    else:
        assert profile["sandbox_mode"] == "read-only"
        assert "non-mutating" in instructions.lower()


assert not (ROOT / ".codex" / "agents" / "independent-review.toml").exists()
print("Codex agent profile smoke tests passed")
