#!/usr/bin/env bash
set -euo pipefail

source_root="$(git rev-parse --show-toplevel)"
test_dir="$(mktemp -d "${TMPDIR:-/tmp}/trading-run-worker-test.XXXXXX")"
repo="$test_dir/repo"
stub_dir="$test_dir/bin"

cleanup() {
  rm -rf -- "$test_dir"
}

trap cleanup EXIT INT TERM

fail() {
  echo "run-worker-test: $*" >&2
  exit 1
}

expect_status() {
  local expected="$1"
  local name="$2"
  shift 2

  set +e
  "$@" >"$test_dir/$name.stdout" 2>"$test_dir/$name.stderr"
  local actual=$?
  set -e

  [[ "$actual" -eq "$expected" ]] ||
    fail "$name returned $actual instead of $expected"
}

mkdir -p "$repo" "$stub_dir"
cp "$source_root/AGENTS.md" "$repo/AGENTS.md"
cp "$source_root/.gitignore" "$repo/.gitignore"
cp -R "$source_root/.agent" "$repo/.agent"

git -C "$repo" init -q
git -C "$repo" config user.name "Worker Regression"
git -C "$repo" config user.email "worker-regression@example.invalid"
git -C "$repo" config commit.gpgsign false
git -C "$repo" add AGENTS.md .gitignore .agent
git -C "$repo" commit -qm "test fixture"

cat >"$stub_dir/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

output=""
workdir=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --output-last-message)
      output="$2"
      shift 2
      ;;
    -C)
      workdir="$2"
      shift 2
      ;;
    *)
      shift
      ;;
  esac
done

if [[ "${RUN_WORKER_TEST_OMIT_REPORT:-false}" != true ]]; then
  cp "$RUN_WORKER_TEST_REPORT" "$output"
fi

if [[ "${RUN_WORKER_TEST_PROBE_PARENT:-false}" == true ]]; then
  set +e
  "$RUN_WORKER_TEST_ROOT/.agent/bin/worker-guard" probe >/dev/null
  probe_status=$?
  set -e
  printf '%s\n' "$probe_status" >"$RUN_WORKER_TEST_PROBE_RESULT"
fi

if [[ "${RUN_WORKER_TEST_MUTATE_PRIMARY:-false}" == true ]]; then
  printf '\nprimary staged mutation\n' >>"$RUN_WORKER_TEST_ROOT/AGENTS.md"
  git -C "$RUN_WORKER_TEST_ROOT" add AGENTS.md
fi

if [[ "${RUN_WORKER_TEST_MUTATE_REVIEW:-false}" == true && \
  "$workdir" != "$RUN_WORKER_TEST_ROOT" ]]
then
  printf '\ncommitted review mutation\n' >>"$workdir/AGENTS.md"
  git -C "$workdir" add AGENTS.md
  git -C "$workdir" commit -qm "reviewer mutation"
fi

if [[ "${RUN_WORKER_TEST_CAPTURE_REVIEW_HEAD:-false}" == true && \
  "$workdir" != "$RUN_WORKER_TEST_ROOT" ]]
then
  git -C "$workdir" rev-parse HEAD >"$RUN_WORKER_TEST_REVIEW_HEAD_RESULT"
fi

[[ -n "$workdir" ]]
EOF
chmod +x "$stub_dir/codex"

