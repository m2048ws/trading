python3 - "$test_dir" <<'PY'
import copy
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
valid_paths = {
    "apply": root / "matching-apply-report.json",
    "review": root / "review-report.json",
    "remediate": root / "remediate-report.json",
    "finalize": root / "finalize-report.json",
}

for role, valid_path in valid_paths.items():
    valid = json.loads(valid_path.read_text())

    schema_invalid = copy.deepcopy(valid)
    schema_invalid["summary"] = False
    (root / f"{role}-schema-invalid-report.json").write_text(
        json.dumps(schema_invalid)
    )

    contradictory = copy.deepcopy(valid)
    if role in {"apply", "review"}:
        contradictory["validation"]["passed"] = False
    elif role == "remediate":
        contradictory["finding_results"][0]["closed_after"] = False
    else:
        contradictory["archive"]["completed"] = False
    (root / f"{role}-contradictory-report.json").write_text(
        json.dumps(contradictory)
    )

    (root / f"{role}-summary-only-report.json").write_text(
        json.dumps({"summary": f"{role} prose summary only"})
    )
    (root / f"{role}-malformed-report.json").write_text('{"summary":')

    cross_change = copy.deepcopy(valid)
    if role == "apply":
        cross_change["openspec"]["change"] = "different-change"
    elif role in {"review", "remediate"}:
        cross_change["openspec"]["change"] = "different-change"
    else:
        cross_change["openspec"] = {"change": "different-change"}
    (root / f"{role}-cross-change-report.json").write_text(
        json.dumps(cross_change)
    )


def write_variant(name, source, update):
    report = copy.deepcopy(source)
    update(report)
    (root / f"finalize-{name}-report.json").write_text(json.dumps(report))


commit_ready = json.loads((root / "finalize-report.json").read_text())
committed = json.loads((root / "finalize-committed-report.json").read_text())

write_variant(
    "commit-ready-clean-index",
    commit_ready,
    lambda report: report["git"].update(staged=False),
)
write_variant(
    "commit-ready-authorized",
    commit_ready,
    lambda report: report["commit"].update(authorized=True),
)
write_variant(
    "commit-ready-created",
    commit_ready,
    lambda report: report["commit"].update(created=True),
)
write_variant(
    "commit-ready-hash",
    commit_ready,
    lambda report: report["commit"].update(hash="unexpected-commit"),
)
write_variant(
    "committed-staged",
    committed,
    lambda report: report["git"].update(staged=True),
)
write_variant(
    "committed-unauthorized",
    committed,
    lambda report: report["commit"].update(authorized=False),
)
write_variant(
    "committed-not-created",
    committed,
    lambda report: report["commit"].update(created=False),
)
write_variant(
    "committed-empty-hash",
    committed,
    lambda report: report["commit"].update(hash=""),
)
write_variant(
    "committed-head-mismatch",
    committed,
    lambda report: report["commit"].update(hash="different-commit"),
)
PY

report_context() {
  case "$1" in
    apply) printf '%s\n' "$test_dir/matching-apply-context.json" ;;
    review) printf '%s\n' "$test_dir/review-context.json" ;;
    remediate) printf '%s\n' "$test_dir/remediate-context.json" ;;
    finalize) printf '%s\n' "$test_dir/finalize-context.json" ;;
    *) fail "unknown report role $1" ;;
  esac
}

report_change() {
  case "$1" in
    review) printf '%s\n' test-change ;;
    apply | remediate | finalize) printf '%s\n' assigned-change ;;
    *) fail "unknown report role $1" ;;
  esac
}

valid_report() {
  case "$1" in
    apply) printf '%s\n' "$test_dir/matching-apply-report.json" ;;
    review) printf '%s\n' "$test_dir/review-report.json" ;;
    remediate) printf '%s\n' "$test_dir/remediate-report.json" ;;
    finalize) printf '%s\n' "$test_dir/finalize-report.json" ;;
    *) fail "unknown report role $1" ;;
  esac
}

assert_rejection_diagnostic() {
  local role="$1"
  local report_case="$2"
  local stderr_file="$3"

  case "$report_case" in
    missing | malformed)
      grep -Fq "Invalid report JSON" "$stderr_file" ||
        fail "$report_case diagnostic was omitted from $stderr_file"
      ;;
    schema-invalid)
      grep -Fq "expected type" "$stderr_file" ||
        fail "schema-invalid diagnostic was omitted from $stderr_file"
      ;;
    summary-only)
      grep -Fq "missing required property" "$stderr_file" ||
        fail "summary-only diagnostic was omitted from $stderr_file"
      ;;
    contradictory)
      grep -Fq "INVALID " "$stderr_file" ||
        fail "contradictory-report diagnostic was omitted from $stderr_file"
      ;;
    cross-change)
      case "$role" in
        apply)
          grep -Fq "OpenSpec change does not match assigned change" "$stderr_file" ||
            fail "apply cross-change diagnostic was omitted from $stderr_file"
          ;;
        review | remediate)
          grep -Fq "$.openspec: unexpected property 'change'" "$stderr_file" ||
            fail "$role identity-injection diagnostic was omitted from $stderr_file"
          ;;
        finalize)
          grep -Fq "$: unexpected property 'openspec'" "$stderr_file" ||
            fail "finalize identity-injection diagnostic was omitted from $stderr_file"
          ;;
        *) fail "unknown report role $role" ;;
      esac
      ;;
    *) fail "unknown report case $report_case" ;;
  esac
}

assert_formal_report_rejected() {
  local role="$1"
  local report_case="$2"
  local context
  local change
  local report_source
  local worker_report
  local omit_report=false
  local schema="$repo/.agent/schemas/$role.json"

  context="$(report_context "$role")"
  change="$(report_change "$role")"
  if [[ "$report_case" == missing ]]; then
    report_source="$test_dir/$role-missing-report.json"
    worker_report="$(valid_report "$role")"
    omit_report=true
  elif [[ "$report_case" == cross-change ]]; then
    report_source="$test_dir/$role-cross-change-report.json"
    worker_report="$report_source"
  else
    report_source="$test_dir/$role-$report_case-report.json"
    worker_report="$report_source"
  fi

  expect_status 1 "validator-$role-$report_case" \
    "$repo/.agent/bin/validate-worker-report" \
    "$role" "$report_source" "$schema" "$change"
  assert_rejection_diagnostic \
    "$role" "$report_case" "$test_dir/validator-$role-$report_case.stderr"

  expect_status 3 "script-$role-$report_case" \
    env \
    PATH="$test_path" \
    RUN_WORKER_TEST_ROOT="$repo" \
    RUN_WORKER_TEST_REPORT="$worker_report" \
    RUN_WORKER_TEST_OMIT_REPORT="$omit_report" \
    "$repo/.agent/bin/run-worker" \
    "$role" "$change" "$context" \
    "$test_dir/script-$role-$report_case-output.json"
  assert_rejection_diagnostic \
    "$role" "$report_case" "$test_dir/script-$role-$report_case.stderr"
  grep -Fq "Worker produced an invalid structured report" \
    "$test_dir/script-$role-$report_case.stderr" ||
    fail "$role $report_case did not fail at the script report boundary"
  "$repo/.agent/bin/worker-guard" probe >/dev/null ||
    fail "$role $report_case retained a primary-worktree writer reservation"
}

assert_finalize_report_accepted() {
  local name="$1"
  local report_source="$2"
  local schema="$repo/.agent/schemas/finalize.json"

  "$repo/.agent/bin/validate-worker-report" \
    finalize "$report_source" "$schema" assigned-change \
    >"$test_dir/validator-finalize-$name.stdout" \
    2>"$test_dir/validator-finalize-$name.stderr"

  env \
    PATH="$test_path" \
    RUN_WORKER_TEST_ROOT="$repo" \
    RUN_WORKER_TEST_REPORT="$report_source" \
    "$repo/.agent/bin/run-worker" \
    finalize assigned-change "$test_dir/finalize-context.json" \
    "$test_dir/script-finalize-$name-output.json" \
    >"$test_dir/script-finalize-$name.stdout" \
    2>"$test_dir/script-finalize-$name.stderr"
}

assert_finalize_product_rejected() {
  local name="$1"
  local report_source="$test_dir/finalize-$name-report.json"
  local schema="$repo/.agent/schemas/finalize.json"

  expect_status 1 "validator-finalize-$name" \
    "$repo/.agent/bin/validate-worker-report" \
    finalize "$report_source" "$schema" assigned-change
  grep -Fq "INVALID FINALIZE REPORT" \
    "$test_dir/validator-finalize-$name.stderr" ||
    fail "$name direct validation diagnostic was omitted"

  expect_status 3 "script-finalize-$name" \
    env \
    PATH="$test_path" \
    RUN_WORKER_TEST_ROOT="$repo" \
    RUN_WORKER_TEST_REPORT="$report_source" \
    "$repo/.agent/bin/run-worker" \
    finalize assigned-change "$test_dir/finalize-context.json" \
    "$test_dir/script-finalize-$name-output.json"
  grep -Fq "Worker produced an invalid structured report" \
    "$test_dir/script-finalize-$name.stderr" ||
    fail "$name did not fail at the script report boundary"
  "$repo/.agent/bin/worker-guard" probe >/dev/null ||
    fail "$name retained a primary-worktree writer reservation"
}

test_path="$stub_dir:$PATH"

cd "$repo"

for role in apply review remediate finalize; do
  for report_case in missing malformed schema-invalid summary-only contradictory cross-change; do
    assert_formal_report_rejected "$role" "$report_case"
