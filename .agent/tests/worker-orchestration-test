    "detailed_collection_result_bytes": artifacts["detail"]["bytes"],
    "collection_diagnostics_bytes": artifacts["diagnostics"]["bytes"],
    "compact_collection_bytes": os.path.getsize(collect_path),
    "prepare_elapsed_ms": round((int(pf) - int(ps)) / 1_000_000, 1),
