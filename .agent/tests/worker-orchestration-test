python3 - "$test_dir" <<'PY'
import copy
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])
valid = json.loads((root / "valid-report.json").read_text())

schema_invalid = copy.deepcopy(valid)
schema_invalid["summary"] = False
(root / "report-schema-invalid.json").write_text(json.dumps(schema_invalid))

contradictory = copy.deepcopy(valid)
contradictory["validation"]["passed"] = False
(root / "report-contradictory.json").write_text(json.dumps(contradictory))

cross_change = copy.deepcopy(valid)
cross_change["openspec"]["change"] = "different-change"
(root / "report-cross-change.json").write_text(json.dumps(cross_change))

(root / "report-summary-only.json").write_text(
    json.dumps({"summary": "native prose summary only"})
)
(root / "report-malformed.json").write_text('{"summary":')
PY

# Keep the established broker protocol regressions as internal diagnostic
# coverage while the public policy rejects every native primary-worktree
# writer. This wrapper can exercise the dormant protocol only inside this test;
# no repository command or policy field exposes the override.
cat >"$broker_fixture" <<'PY'
#!/usr/bin/env python3
import importlib.util
import importlib.machinery
import json
import os
import pathlib
import sys

sys.dont_write_bytecode = True
module_path = pathlib.Path(os.environ["NATIVE_WORKER_TEST_MODULE"])
sys.path.insert(0, str(module_path.parent))
loader = importlib.machinery.SourceFileLoader(
    "native_worker_internal_fixture", str(module_path)
)
spec = importlib.util.spec_from_loader("native_worker_internal_fixture", loader)
module = importlib.util.module_from_spec(spec)
assert spec.loader is not None
spec.loader.exec_module(module)
production_selection = module.selection


def internal_selection(role, capabilities):
    selected = production_selection(role, capabilities)
    if role == "apply":
        policy = module.role_policy(role)
        missing = [
            guard
            for guard in policy["required_native_guards"]
            if capabilities.get(guard) is not True
        ]
        if not missing:
            selected["selected_backend"] = "native"
            selected["native_eligible"] = True
            selected["reasons"] = []
    return selected


module.selection = internal_selection
# The dormant broker protocol remains test-only. Production preparation has an
# independent immutable formal-role deny, so this isolated fixture must remove
# that deny in-process before exercising the nonauthorizing future protocol.
module.FORMAL_ROLE_NAMES = frozenset()
if len(sys.argv) == 3 and sys.argv[1] == "broker":
    capabilities = module.load_capabilities(pathlib.Path(sys.argv[2]))
    module.AuthorityBroker(capabilities).serve()
else:
    raise SystemExit(2)
PY
chmod +x "$broker_fixture"

"$native" select apply "$test_dir/all-capabilities.json" \
  >"$test_dir/select-apply.json"
[[ "$(field "$test_dir/select-apply.json" selected_backend)" == script ]] ||
  fail "apply was eligible despite an unprotected executable closure"
grep -Fq 'protected_executable_trust_closure_unavailable' \
