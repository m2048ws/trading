write_valid_report "$test_dir/prepare-two.json"
lease_two="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["assigned_paths"]["lease"])' "$(field "$test_dir/prepare-two.json" manifest_file)")"
cp "$lease_two" "$test_dir/lease-two.original"
cp "$test_dir/lease-one.original" "$lease_two"
collect "$test_dir/prepare-two.json" "$test_dir/restored-stale-lease.json"
[[ "$(field "$test_dir/restored-stale-lease.json" integrity_valid)" == false ]] ||
  fail "restored stale lease was accepted"
set +e
"$guard" probe >/dev/null
probe_status=$?
set -e
[[ "$probe_status" -eq 3 ]] || fail "lease tamper released writer"
cp "$test_dir/lease-two.original" "$lease_two"
collect "$test_dir/prepare-two.json" "$test_dir/collect-two.json"
[[ "$(field "$test_dir/collect-two.json" transition_authority)" == true ]] ||
  fail "corrected authentic lease could not be collected"

prepare "$test_dir/prepare-three.json"
manifest_three="$(field "$test_dir/prepare-three.json" manifest_file)"
cp "$manifest_three" "$test_dir/manifest-three.original"
for tamper_case in role change report schema initial launch-id generation lease; do
  cp "$test_dir/manifest-three.original" "$manifest_three"
  python3 - "$manifest_three" "$tamper_case" <<'PY'
import json
import sys

path, case = sys.argv[1:]
manifest = json.load(open(path))
if case == "role":
    manifest["role"] = "remediate"
elif case == "change":
    manifest["change"] = "different-change"
elif case == "report":
    manifest["assigned_paths"]["report"] += ".forged"
elif case == "schema":
    manifest["assigned_paths"]["schema"] += ".forged"
elif case == "initial":
    manifest["initial_repository"]["head"] = "0" * 40
elif case == "launch-id":
    manifest["launch_id"] = "forged-launch-id"
elif case == "generation":
    manifest["generation"] += 1
elif case == "lease":
    manifest["lease_sha256"] = "sha256:" + "0" * 64
json.dump(manifest, open(path, "w"), indent=2, sort_keys=True)
PY
  collect "$test_dir/prepare-three.json" \
    "$test_dir/tampered-manifest-$tamper_case.json"
  [[ "$(field "$test_dir/tampered-manifest-$tamper_case.json" integrity_valid)" == false ]] ||
    fail "manifest $tamper_case tamper was accepted"
  [[ "$(field "$test_dir/tampered-manifest-$tamper_case.json" transition_authority)" == false ]] ||
    fail "manifest $tamper_case tamper granted transition authority"
  [[ "$(field "$test_dir/tampered-manifest-$tamper_case.json" fallback_safe)" == false ]] ||
    fail "manifest $tamper_case tamper authorized safe fallback"
  set +e
  "$guard" probe >/dev/null
  probe_status=$?
  set -e
  [[ "$probe_status" -eq 3 ]] ||
    fail "manifest $tamper_case tamper released writer"
done
cp "$test_dir/manifest-three.original" "$manifest_three"
broker_request "$test_dir/capability-mismatch.json" "$(
  python3 -c '
import json, sys
print(json.dumps({
    "command": "collect",
    "launch_id": sys.argv[1],
    "generation": int(sys.argv[2]),
    "capability": "worker-readable-forgery"
}))
' "$(field "$test_dir/prepare-three.json" launch_id)" \
    "$(field "$test_dir/prepare-three.json" generation)"
)"
[[ "$(field "$test_dir/capability-mismatch.json" status)" == 4 ]] ||
  fail "worker-supplied capability was accepted"

lease_three="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["assigned_paths"]["lease"])' "$manifest_three")"
rm -f -- "$lease_three"
collect "$test_dir/prepare-three.json" "$test_dir/missing-lease.json"
[[ "$(field "$test_dir/missing-lease.json" integrity_valid)" == false ]] ||
  fail "missing lease evidence was accepted"
recover "$test_dir/prepare-three.json" "$test_dir/recovered.json"
[[ "$(field "$test_dir/recovered.json" recovered)" == true ]] ||
