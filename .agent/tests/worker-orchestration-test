#!/usr/bin/env bash
set -euo pipefail

source_root="$(git rev-parse --show-toplevel)"
test_dir="$(mktemp -d "${TMPDIR:-/tmp}/trading-worker-broker-test.XXXXXX")"
root="$test_dir/repo"
mkdir -p "$root"
cp "$source_root/AGENTS.md" "$root/AGENTS.md"
cp "$source_root/.gitignore" "$root/.gitignore"
cp -R "$source_root/.agent" "$root/.agent"
git -C "$root" init -q
git -C "$root" config user.name "Native Worker Regression"
git -C "$root" config user.email "native-worker@example.invalid"
git -C "$root" config commit.gpgsign false
git -C "$root" add AGENTS.md .gitignore .agent
git -C "$root" commit -qm initial
native="$root/.agent/bin/native-worker"
guard="$root/.agent/bin/worker-guard"
broker_fixture="$test_dir/native-worker-internal-broker-fixture"
mutation_path="$root/.agent-native-worker-test-mutation"
broker_in=""
broker_out=""
broker_pid=""

cleanup() {
  rm -f -- "$mutation_path"
  if [[ -n "$broker_pid" ]]; then
    kill "$broker_pid" >/dev/null 2>&1 || true
    wait "$broker_pid" >/dev/null 2>&1 || true
  fi
  rm -rf -- "$test_dir"
}

trap cleanup EXIT INT TERM

fail() {
  echo "worker-orchestration-test: $*" >&2
  exit 1
}

field() {
  python3 -c '
import json, sys
value = json.load(open(sys.argv[1])) if sys.argv[1] != "-" else json.load(sys.stdin)
for part in sys.argv[2].split("."):
    value = value[int(part)] if isinstance(value, list) else value[part]
if isinstance(value, bool):
    print("true" if value else "false")
elif value is None:
    print("null")
else:
    print(value)
' "$1" "$2"
}

request_json() {
  local command="$1"
  shift
  python3 -c '
import json, sys
command = sys.argv[1]
args = sys.argv[2:]
request = {"command": command}
for index in range(0, len(args), 2):
    key, value = args[index:index + 2]
    request[key] = int(value) if key == "generation" else value
print(json.dumps(request, separators=(",", ":")))
' "$command" "$@"
}

start_broker() {
  coproc TEST_BROKER {
    NATIVE_WORKER_TEST_MODULE="$native" \
      "$broker_fixture" broker "$test_dir/all-capabilities.json"
  }
  broker_out="${TEST_BROKER[0]}"
  broker_in="${TEST_BROKER[1]}"
  broker_pid="$TEST_BROKER_PID"
  IFS= read -r broker_response <&"$broker_out"
  printf '%s\n' "$broker_response" >"$test_dir/broker-ready.json"
  [[ "$(field "$test_dir/broker-ready.json" broker_ready)" == true ]] ||
    fail "broker did not report ready"
}

broker_request() {
  local output="$1"
  local request="$2"
  printf '%s\n' "$request" >&"$broker_in"
  IFS= read -r broker_response <&"$broker_out"
  printf '%s\n' "$broker_response" >"$output"
}

prepare() {
  local output="$1"
  broker_request "$output" "$(
    request_json prepare role apply change broker-test \
      context_file "$test_dir/apply-context.json"
  )"
}

collect() {
  local prepare_file="$1"
  local output="$2"
  broker_request "$output" "$(
    request_json collect \
      launch_id "$(field "$prepare_file" launch_id)" \
      generation "$(field "$prepare_file" generation)" \
      agent_id test-agent thread_id test-thread
  )"
}

classify() {
  local prepare_file="$1"
  local output="$2"
  broker_request "$output" "$(
    request_json classify_failure \
      launch_id "$(field "$prepare_file" launch_id)" \
      generation "$(field "$prepare_file" generation)" \
      agent_id test-agent thread_id test-thread
  )"
}

recover() {
  local prepare_file="$1"
  local output="$2"
  broker_request "$output" "$(
    request_json recover \
      launch_id "$(field "$prepare_file" launch_id)" \
      generation "$(field "$prepare_file" generation)" \
      reason "protected test recovery"
  )"
}

write_valid_report() {
  cp "$test_dir/valid-report.json" "$(field "$1" report_file)"
}

cat >"$test_dir/all-capabilities.json" <<'EOF'
