manifest_one="$(field "$test_dir/prepare-one.json" manifest_file)"
report_one="$(field "$test_dir/prepare-one.json" report_file)"
lease_one="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["assigned_paths"]["lease"])' "$manifest_one")"
cp "$lease_one" "$test_dir/lease-one.original"
! grep -REq '"capability"[[:space:]]*:' \
  "$manifest_one" "$lease_one" "$(field "$test_dir/prepare-one.json" prompt_file)" ||
  fail "worker-readable handoff exposed one-shot capability"

set +e
"$guard" probe >"$test_dir/probe-active.json"
probe_status=$?
set -e
[[ "$probe_status" -eq 3 ]] || fail "active native broker did not exclude another writer"

set +e
"$root/.agent/bin/run-worker" apply broker-test \
  "$test_dir/apply-context.json" "$test_dir/cross-backend-report.json" \
  >"$test_dir/cross-backend.stdout" 2>"$test_dir/cross-backend.stderr"
cross_backend_status=$?
set -e
[[ "$cross_backend_status" -eq 6 ]] ||
  fail "script writer was admitted while native broker was active"
grep -Fq 'primary-worktree writer is already active' \
  "$test_dir/cross-backend.stderr" ||
  fail "cross-backend collision diagnostic was omitted"

set +e
"$native" collect "$manifest_one" authentic-readable-digest \
  >"$test_dir/self-release.stdout" 2>"$test_dir/self-release.stderr"
self_release_status=$?
set -e
[[ "$self_release_status" -eq 2 ]] ||
  fail "worker-readable artifacts reached a public collection command"
set +e
"$native" recover "$manifest_one" authentic-readable-digest \
  >/dev/null 2>"$test_dir/self-recovery.stderr"
self_recovery_status=$?
set -e
[[ "$self_recovery_status" -eq 2 ]] ||
  fail "worker-readable artifacts reached a public recovery command"
set +e
"$guard" probe >/dev/null
probe_status=$?
set -e
[[ "$probe_status" -eq 3 ]] || fail "self-release attempt released writer"

for report_case in missing malformed schema-invalid summary-only contradictory cross-change; do
  rm -f -- "$report_one"
  if [[ "$report_case" != missing ]]; then
    cp "$test_dir/report-$report_case.json" "$report_one"
  fi
  collect "$test_dir/prepare-one.json" "$test_dir/rejected-report-$report_case.json"
  [[ "$(field "$test_dir/rejected-report-$report_case.json" status)" == 3 ]] ||
    fail "$report_case report did not reject collection"
  [[ "$(field "$test_dir/rejected-report-$report_case.json" report_valid)" == false ]] ||
    fail "$report_case report passed validation"
  [[ "$(field "$test_dir/rejected-report-$report_case.json" transition_authority)" == false ]] ||
    fail "$report_case report granted transition authority"
  [[ "$(field "$test_dir/rejected-report-$report_case.json" fallback_safe)" == false ]] ||
    fail "$report_case report authorized safe fallback"
  set +e
  "$guard" probe >/dev/null
  probe_status=$?
  set -e
  [[ "$probe_status" -eq 3 ]] ||
    fail "$report_case report rejection did not retain writer"
done

write_valid_report "$test_dir/prepare-one.json"
collect_started="$(python3 -c 'import time; print(time.time_ns())')"
collect "$test_dir/prepare-one.json" "$test_dir/collect-one.json"
collect_finished="$(python3 -c 'import time; print(time.time_ns())')"
