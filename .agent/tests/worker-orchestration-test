"$guard" probe >/dev/null || fail "successful collection retained writer"

collect "$test_dir/prepare-one.json" "$test_dir/replay-one.json"
[[ "$(field "$test_dir/replay-one.json" status)" == 4 ]] ||
  fail "consumed generation replay was not rejected"

prepare "$test_dir/prepare-two.json"
[[ "$(field "$test_dir/prepare-two.json" generation)" == 2 ]] ||
  fail "broker generation did not increase monotonically"
collect "$test_dir/prepare-one.json" "$test_dir/stale-against-two.json"
[[ "$(field "$test_dir/stale-against-two.json" status)" == 4 ]] ||
