! grep -Fq 'broker-valid-report-marker' "$test_dir/collect-one.json" ||
  fail "compact collection inlined the complete report"
! grep -Fq 'active_changes' "$test_dir/collect-one.json" ||
  fail "compact collection inlined complete steward state"
detail_one="$(field "$test_dir/collect-one.json" artifacts.detail.path)"
grep -Fq 'broker-valid-report-marker' "$detail_one" ||
  fail "detailed artifact omitted complete report"
grep -Fq '"capability_consumed": true' "$detail_one" ||
  fail "detailed artifact omitted broker generation outcome"
python3 - \
  "$test_dir/prepare-one.json" \
  "$test_dir/collect-one.json" \
  "$prepare_started" \
  "$prepare_finished" \
  "$collect_started" \
  "$collect_finished" \
  "$root/.agent/reports/native-broker-measurements.json" <<'PY'
