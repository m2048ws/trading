    fail "$writer_role was incorrectly eligible for native execution"
done

"$native" select exploration "$test_dir/all-capabilities.json" \
  >"$test_dir/select-exploration.json"
[[ "$(field "$test_dir/select-exploration.json" selected_backend)" == native ]] ||
