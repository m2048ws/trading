rm -f -- "$mutation_path"

printf 'mode-before-launch\n' >"$mutation_path"
prepare "$test_dir/prepare-seven.json"
chmod +x "$mutation_path"
classify "$test_dir/prepare-seven.json" "$test_dir/classify-mode.json"
[[ "$(field "$test_dir/classify-mode.json" fallback_safe)" == false ]] ||
