prepare "$test_dir/prepare-nine.json"
mkdir -p "$root/target"
printf 'ignored diagnostic\n' >"$root/target/native-broker-ignored-output"
classify "$test_dir/prepare-nine.json" "$test_dir/classify-ignored.json"
[[ "$(field "$test_dir/classify-ignored.json" fallback_safe)" == true ]] ||
  fail "ignored output changed repository identity"
rm -f -- "$root/target/native-broker-ignored-output"

broker_request "$test_dir/shutdown.json" '{"command":"shutdown"}'
[[ "$(field "$test_dir/shutdown.json" shutdown)" == true ]] ||
  fail "idle broker did not shut down"
wait "$broker_pid"
broker_pid=""

# The identity helper must resolve relative Git paths against its own target
# repository even when invoked from a different repository.
repo_a="$test_dir/repo-a"
repo_b="$test_dir/repo-b"
mkdir -p "$repo_a" "$repo_b/.agent/bin"
cp "$root/.agent/bin/repository-identity" "$repo_b/.agent/bin/repository-identity"
for repo in "$repo_a" "$repo_b"; do
  git -C "$repo" init -q
  git -C "$repo" config user.name "Identity Regression"
  git -C "$repo" config user.email "identity@example.invalid"
  git -C "$repo" config commit.gpgsign false
  printf '%s\n' "$(basename "$repo")" >"$repo/tracked"
  git -C "$repo" add tracked
  git -C "$repo" commit -qm initial
done
printf 'repo-a-second\n' >>"$repo_a/tracked"
git -C "$repo_a" add tracked
git -C "$repo_a" commit -qm second
printf 'repo-b-staged\n' >>"$repo_b/tracked"
git -C "$repo_b" add tracked
printf 'repo-b-dirty\n' >>"$repo_b/tracked"
printf 'repo-b-untracked\n' >"$repo_b/untracked"
(
  cd "$repo_b"
  "$repo_b/.agent/bin/repository-identity" >"$test_dir/identity-inside.json"
)
(
  cd "$repo_a"
  "$repo_b/.agent/bin/repository-identity" >"$test_dir/identity-cross-cwd.json"
)
cmp "$test_dir/identity-inside.json" "$test_dir/identity-cross-cwd.json" ||
  fail "cross-cwd identity mixed target and caller repositories"
[[ "$(field "$test_dir/identity-cross-cwd.json" head)" == "$(git -C "$repo_b" rev-parse HEAD)" ]] ||
  fail "cross-cwd identity reported caller HEAD"
[[ "$(field "$test_dir/identity-cross-cwd.json" head)" != "$(git -C "$repo_a" rev-parse HEAD)" ]] ||
  fail "cross-cwd identity used repository A HEAD"
cp "$repo_b/tracked" "$test_dir/repo-b-tracked.original"
printf 'repo-b-dirty-mutated\n' >>"$repo_b/tracked"
"$repo_b/.agent/bin/repository-identity" >"$test_dir/identity-tracked-mutated.json"
[[ "$(field "$test_dir/identity-tracked-mutated.json" working_tree_fingerprint)" != \
   "$(field "$test_dir/identity-inside.json" working_tree_fingerprint)" ]] ||
  fail "tracked dirty same-path content mutation was invisible"
cp "$test_dir/repo-b-tracked.original" "$repo_b/tracked"
chmod +x "$repo_b/tracked"
"$repo_b/.agent/bin/repository-identity" >"$test_dir/identity-tracked-mode.json"
[[ "$(field "$test_dir/identity-tracked-mode.json" working_tree_fingerprint)" != \
   "$(field "$test_dir/identity-inside.json" working_tree_fingerprint)" ]] ||
  fail "tracked dirty same-path mode mutation was invisible"

# Public native preparation must refuse every primary-worktree writer before
# any worker can tamper with the executable decision closure. The script
# fallback owns its reservation independently, so broker death cannot release
# an active formal writer.
loss_repo="$test_dir/loss-repo"
cp -R "$root/.agent" "$loss_repo-agent"
mkdir -p "$loss_repo"
mv "$loss_repo-agent" "$loss_repo/.agent"
cp "$root/AGENTS.md" "$loss_repo/AGENTS.md"
cp "$root/.gitignore" "$loss_repo/.gitignore"
git -C "$loss_repo" init -q
git -C "$loss_repo" config user.name "Broker Loss Regression"
git -C "$loss_repo" config user.email "broker-loss@example.invalid"
git -C "$loss_repo" config commit.gpgsign false
git -C "$loss_repo" add AGENTS.md .gitignore .agent
git -C "$loss_repo" commit -qm initial
cp "$test_dir/all-capabilities.json" "$loss_repo/capabilities.json"
cp "$test_dir/apply-context.json" "$loss_repo/context.json"
cp "$loss_repo/.agent/worker-roles.json" "$test_dir/loss-policy-original.json"
loss_reports_before="$(python3 -c '
import pathlib, sys
root = pathlib.Path(sys.argv[1])
print(sum(path.is_file() for path in root.rglob("*")) if root.exists() else 0)
' "$loss_repo/.agent/reports")"

coproc SCRIPT_WRITER_GUARD {
  PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH="$loss_repo/.agent/bin" \
    python3 -u -c '
import pathlib
import sys
from worker_guard import WriterReservation

reservation = WriterReservation(pathlib.Path(sys.argv[1]))
reservation.acquire()
print("ready", flush=True)
sys.stdin.read(1)
reservation.close()
' "$loss_repo"
}
script_guard_out="${SCRIPT_WRITER_GUARD[0]}"
script_guard_in="${SCRIPT_WRITER_GUARD[1]}"
script_guard_pid="$SCRIPT_WRITER_GUARD_PID"
IFS= read -r script_guard_ready <&"$script_guard_out"
[[ "$script_guard_ready" == ready ]] ||
  fail "script fallback did not acquire its parent-owned reservation"

coproc LOSS_BROKER { "$loss_repo/.agent/bin/native-worker" broker "$loss_repo/capabilities.json"; }
loss_out="${LOSS_BROKER[0]}"
loss_in="${LOSS_BROKER[1]}"
loss_pid="$LOSS_BROKER_PID"
IFS= read -r _ <&"$loss_out"
printf '%s\n' "$(
  request_json prepare role apply change broker-test \
    context_file "$loss_repo/context.json"
)" >&"$loss_in"
IFS= read -r loss_prepare <&"$loss_out"
printf '%s\n' "$loss_prepare" >"$test_dir/loss-prepare.json"
[[ "$(field "$test_dir/loss-prepare.json" prepared)" == false ]] ||
  fail "public broker prepared an ineligible native writer"
[[ "$(field "$test_dir/loss-prepare.json" selected_backend)" == script ]] ||
  fail "public broker omitted deterministic script fallback"

# Reclassifying a formal role through mutable policy after broker start must
# not change its production role-name boundary.
python3 - "$loss_repo/.agent/worker-roles.json" <<'PY'
import json
import sys

path = sys.argv[1]
policy = json.load(open(path))
apply = policy["roles"]["apply"]
apply["mutation_class"] = "read_only"
apply["native_eligible"] = True
apply["preferred_backend"] = "native"
json.dump(policy, open(path, "w"), indent=2, sort_keys=True)
PY
printf '%s\n' "$(request_json select role apply)" >&"$loss_in"
IFS= read -r reclassified_policy_select <&"$loss_out"
printf '%s\n' "$reclassified_policy_select" \
  >"$test_dir/reclassified-policy-select.json"
[[ "$(field "$test_dir/reclassified-policy-select.json" selected_backend)" == script ]] ||
  fail "mutable policy reclassification enabled formal native selection"
grep -Fq 'formal_role_requires_script' \
  "$test_dir/reclassified-policy-select.json" ||
  fail "mutable policy denial omitted immutable formal-role reason"
printf '%s\n' "$(
  request_json prepare role apply change broker-test \
    context_file "$loss_repo/context.json"
)" >&"$loss_in"
IFS= read -r reclassified_policy_prepare <&"$loss_out"
printf '%s\n' "$reclassified_policy_prepare" \
  >"$test_dir/reclassified-policy-prepare.json"
[[ "$(field "$test_dir/reclassified-policy-prepare.json" prepared)" == false ]] ||
  fail "mutable policy reclassification prepared a formal native launch"

# Restoring policy and replacing only the live classifier with the same
# deceptive classification must remain equally nonauthorizing.
cp "$test_dir/loss-policy-original.json" "$loss_repo/.agent/worker-roles.json"
cat >"$loss_repo/.agent/bin/worker-policy" <<'PY'
#!/usr/bin/env python3
import json
import pathlib
import sys

root = pathlib.Path(__file__).resolve().parents[2]
policy = json.loads((root / ".agent" / "worker-roles.json").read_text())
role = dict(policy["roles"][sys.argv[1]])
if sys.argv[1] == "apply":
    role.update({
        "formal": True,
        "mutation_class": "read_only",
        "native_eligible": True,
        "preferred_backend": "native",
    })
if len(sys.argv) == 3:
    value = role[sys.argv[2]]
    print("true" if value is True else "false" if value is False else value)
else:
    json.dump(role, sys.stdout)
    sys.stdout.write("\n")
PY
chmod +x "$loss_repo/.agent/bin/worker-policy"
printf '%s\n' "$(request_json select role apply)" >&"$loss_in"
IFS= read -r reclassified_helper_select <&"$loss_out"
printf '%s\n' "$reclassified_helper_select" \
  >"$test_dir/reclassified-helper-select.json"
[[ "$(field "$test_dir/reclassified-helper-select.json" selected_backend)" == script ]] ||
  fail "mutable helper reclassification enabled formal native selection"
printf '%s\n' "$(
  request_json prepare role apply change broker-test \
    context_file "$loss_repo/context.json"
)" >&"$loss_in"
IFS= read -r reclassified_helper_prepare <&"$loss_out"
printf '%s\n' "$reclassified_helper_prepare" \
  >"$test_dir/reclassified-helper-prepare.json"
[[ "$(field "$test_dir/reclassified-helper-prepare.json" prepared)" == false ]] ||
  fail "mutable helper reclassification prepared a formal native launch"
printf '%s\n' '{"command":"status"}' >&"$loss_in"
IFS= read -r reclassified_status <&"$loss_out"
printf '%s\n' "$reclassified_status" >"$test_dir/reclassified-status.json"
[[ "$(field "$test_dir/reclassified-status.json" active)" == null ]] ||
  fail "reclassification created active formal native authority"
loss_reports_after="$(python3 -c '
import pathlib, sys
root = pathlib.Path(sys.argv[1])
print(sum(path.is_file() for path in root.rglob("*")) if root.exists() else 0)
' "$loss_repo/.agent/reports")"
[[ "$loss_reports_after" -eq "$loss_reports_before" ]] ||
  fail "reclassified formal preparation created handoff artifacts"

printf '#!/bin/sh\nexit 0\n' >"$loss_repo/.agent/bin/validate-worker-report"
printf '#!/bin/sh\nprintf "{}\\n"\n' >"$loss_repo/.agent/bin/steward-state"
printf '#!/bin/sh\nprintf "{}\\n"\n' >"$loss_repo/.agent/bin/repository-identity"
chmod +x \
  "$loss_repo/.agent/bin/validate-worker-report" \
  "$loss_repo/.agent/bin/steward-state" \
  "$loss_repo/.agent/bin/repository-identity"
printf '%s\n' "$(
  request_json prepare role apply change broker-test \
    context_file "$loss_repo/context.json"
)" >&"$loss_in"
IFS= read -r closure_prepare <&"$loss_out"
printf '%s\n' "$closure_prepare" >"$test_dir/closure-prepare.json"
[[ "$(field "$test_dir/closure-prepare.json" prepared)" == false ]] ||
  fail "tampered executable closure enabled a native writer"

printf '%s\n' "$(
  request_json collect launch_id invented generation 1 \
    agent_id test-agent thread_id test-thread
)" >&"$loss_in"
IFS= read -r closure_collect <&"$loss_out"
printf '%s\n' "$closure_collect" >"$test_dir/closure-collect.json"
[[ "$(field "$test_dir/closure-collect.json" transition_authority)" == false ]] ||
  fail "tampered executable closure created transition authority"

kill "$loss_pid" >/dev/null 2>&1 || true
wait "$loss_pid" >/dev/null 2>&1 || true
set +e
"$loss_repo/.agent/bin/worker-guard" probe >/dev/null
loss_probe_status=$?
set -e
[[ "$loss_probe_status" -eq 3 ]] ||
  fail "broker death released the script fallback's writer reservation"

eval "exec ${script_guard_in}>&-"
wait "$script_guard_pid"
"$loss_repo/.agent/bin/worker-guard" probe >/dev/null ||
  fail "script fallback reservation remained after its owner exited"

[[ ! -e "$root/.agent/bin/__pycache__" ]] ||
  fail "workflow helpers left generated Python bytecode in the repository"

echo "worker orchestration broker regression tests passed"
