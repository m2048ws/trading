  >"$test_dir/select-fallback.json"
[[ "$(field "$test_dir/select-fallback.json" selected_backend)" == script ]] ||
  fail "missing private channel did not select script fallback"
grep -Fq 'missing_guard:steward_private_control_channel' \
  "$test_dir/select-fallback.json" ||
  fail "missing private channel reason was omitted"

"$native" select review "$test_dir/all-capabilities.json" \
  >"$test_dir/select-review.json"
[[ "$(field "$test_dir/select-review.json" selected_backend)" == script ]] ||
  fail "formal review was incorrectly eligible for native execution"

start_broker

prepare_started="$(python3 -c 'import time; print(time.time_ns())')"
prepare "$test_dir/prepare-one.json"
prepare_finished="$(python3 -c 'import time; print(time.time_ns())')"
[[ "$(field "$test_dir/prepare-one.json" prepared)" == true ]] ||
  fail "broker did not prepare native apply"
[[ "$(field "$test_dir/prepare-one.json" generation)" == 1 ]] ||
  fail "first broker generation was not one"
grep -Fq 'Read and execute the complete rendered worker prompt at' \
  "$test_dir/prepare-one.json" || fail "spawn assignment omitted prompt reference"
! grep -Fq '# Apply OpenSpec Change' "$test_dir/prepare-one.json" ||
  fail "spawn assignment inlined the canonical prompt"
! grep -Eq 'launch_authority|one_shot|"capability"' \
