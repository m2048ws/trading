#!/usr/bin/env bash
set -euo pipefail

source_root="$(git rev-parse --show-toplevel)"
test_dir="$(mktemp -d "${TMPDIR:-/tmp}/trading-codex-worker-test.XXXXXX")"
root="$test_dir/repo"
launcher="$root/.agent/bin/codex-worker"
stub_dir="$test_dir/bin"

cleanup() {
  if [[ -n "${test_dir:-}" && -d "$test_dir" ]]; then
    rm -rf -- "$test_dir"
  fi
}

trap cleanup EXIT INT TERM

fail() {
  echo "codex-worker-test: $*" >&2
  exit 1
}

assert_line() {
  local file="$1"
  local expected="$2"

  grep -Fqx -- "$expected" "$file" ||
    fail "missing '$expected' in $file"
}

mkdir -p "$root" "$stub_dir"
cp "$source_root/AGENTS.md" "$root/AGENTS.md"
cp "$source_root/.gitignore" "$root/.gitignore"
cp -R "$source_root/.agent" "$root/.agent"
git -C "$root" init -q
git -C "$root" config user.name "Codex Worker Regression"
git -C "$root" config user.email "codex-worker@example.invalid"
git -C "$root" config commit.gpgsign false
git -C "$root" add AGENTS.md .gitignore .agent
git -C "$root" commit -qm "test fixture"

cat > "$stub_dir/codex" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

model=""
reasoning=""
approval=""
saw_exec=false
saw_ephemeral=false
sandbox=""
workdir=""
output=""
schema=""
saw_stdin=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -m)
      model="$2"
      shift 2
      ;;
    -c)
      reasoning="$2"
      shift 2
      ;;
    --ask-for-approval)
      approval="$2"
      shift 2
      ;;
    exec)
      saw_exec=true
      shift
      ;;
    --ephemeral)
      saw_ephemeral=true
      shift
      ;;
    -C)
      workdir="$2"
      shift 2
      ;;
    --sandbox)
      sandbox="$2"
      shift 2
      ;;
    --output-last-message)
      output="$2"
      shift 2
      ;;
    --output-schema)
      schema="$2"
      shift 2
      ;;
    -)
      saw_stdin=true
      shift
      ;;
    *)
      shift
      ;;
  esac
done

detached=false
snapshot_head=""
snapshot_tree=""

if [[ -n "$workdir" && "$workdir" != "$CODEX_WORKER_TEST_ROOT" ]]; then
  if ! git -C "$workdir" symbolic-ref -q HEAD >/dev/null; then
    detached=true
  fi
  snapshot_head="$(git -C "$workdir" rev-parse HEAD)"
  snapshot_tree="$(git -C "$workdir" rev-parse 'HEAD^{tree}')"
fi

{
  printf 'model=%s\n' "$model"
  printf 'reasoning=%s\n' "$reasoning"
  printf 'approval=%s\n' "$approval"
  printf 'exec=%s\n' "$saw_exec"
  printf 'ephemeral=%s\n' "$saw_ephemeral"
  printf 'sandbox=%s\n' "$sandbox"
  printf 'workdir=%s\n' "$workdir"
  printf 'output=%s\n' "$output"
  printf 'schema=%s\n' "$schema"
  printf 'stdin=%s\n' "$saw_stdin"
  printf 'detached=%s\n' "$detached"
  printf 'snapshot_head=%s\n' "$snapshot_head"
  printf 'snapshot_tree=%s\n' "$snapshot_tree"
} > "$CODEX_WORKER_TEST_CAPTURE"

case "${CODEX_WORKER_TEST_DIRTY:-none}" in
  none)
    ;;
  tracked)
    printf '\ntracked review mutation\n' >> "$workdir/AGENTS.md"
    ;;
  cached)
    printf '\ncached review mutation\n' >> "$workdir/AGENTS.md"
    git -C "$workdir" add AGENTS.md
    ;;
  untracked)
    printf 'untracked review mutation\n' > \
      "$workdir/codex-worker-test-untracked.txt"
    ;;
  ignored)
    mkdir -p "$workdir/target"
    printf 'ignored review build output\n' > \
      "$workdir/target/codex-worker-test-output.txt"
    ;;
  committed)
    printf '\ncommitted review mutation\n' >> "$workdir/AGENTS.md"
    git -C "$workdir" add AGENTS.md
    git -C "$workdir" commit -qm "reviewer mutation"
    ;;
  *)
    echo "Unknown dirty mode: $CODEX_WORKER_TEST_DIRTY" >&2
    exit 98
    ;;
esac

{
  printf 'post_head=%s\n' "$(git -C "$workdir" rev-parse HEAD)"
  printf 'post_tree=%s\n' "$(git -C "$workdir" rev-parse 'HEAD^{tree}')"
  printf 'post_status=%s\n' "$(git -C "$workdir" status --porcelain=v1 --untracked-files=all)"
} >> "$CODEX_WORKER_TEST_CAPTURE"

exit "${CODEX_WORKER_TEST_CHILD_STATUS:-0}"
EOF

bash -n "$stub_dir/codex"
chmod +x "$stub_dir/codex"

cd "$root"

initial_status="$(git -C "$root" status --porcelain=v1 --untracked-files=all)"
initial_tree="$(git -C "$root" write-tree)"
initial_worktrees="$(git -C "$root" worktree list --porcelain)"
test_path="$stub_dir:$PATH"

run_review_case() {
  local name="$1"
  local dirty="$2"
  local child_status="$3"
  local expected_status="$4"
  local capture="$test_dir/$name.capture"
  local stdout="$test_dir/$name.stdout"
  local stderr="$test_dir/$name.stderr"
  local output="$test_dir/$name.json"
  local actual_status
  local workdir

  set +e
  env \
    PATH="$test_path" \
    CODEX_WORKER_TEST_ROOT="$root" \
    CODEX_WORKER_TEST_CAPTURE="$capture" \
    CODEX_WORKER_TEST_DIRTY="$dirty" \
    CODEX_WORKER_TEST_CHILD_STATUS="$child_status" \
    "$launcher" \
    review \
    "$output" \
    "$root/.agent/schemas/review.json" \
    </dev/null >"$stdout" 2>"$stderr"
  actual_status=$?
  set -e

  if [[ "$actual_status" -ne "$expected_status" ]]; then
    cat "$stderr" >&2
    fail "$name returned $actual_status, expected $expected_status"
  fi

  assert_line "$capture" "detached=true"
  assert_line "$capture" "snapshot_tree=$initial_tree"

  workdir="$(sed -n 's/^workdir=//p' "$capture")"
  [[ -n "$workdir" && ! -e "$workdir" ]] ||
    fail "$name did not clean its detached review worktree"

  if [[ "$dirty" == none || "$dirty" == ignored ]]; then
    if grep -Fq "Independent review modified" "$stderr"; then
      fail "$name reported a clean snapshot as dirty"
    fi
  else
    grep -Fq "Independent review modified its isolated review worktree:" \
      "$stderr" || fail "$name omitted dirty-snapshot diagnostics"
  fi

  if [[ "$dirty" == committed ]]; then
    [[ "$(sed -n 's/^post_head=//p' "$capture")" != \
      "$(sed -n 's/^snapshot_head=//p' "$capture")" ]] ||
      fail "$name did not change detached review HEAD"
    [[ "$(sed -n 's/^post_tree=//p' "$capture")" != \
      "$(sed -n 's/^snapshot_tree=//p' "$capture")" ]] ||
      fail "$name did not change detached review tree"
    assert_line "$capture" "post_status="
  fi
}

run_route_case() {
  local role="$1"
  local model
  local effort
  local capture="$test_dir/route-$role.capture"
  local output="$test_dir/route-$role.json"
  local schema="$root/.agent/schemas/$role.json"

  model="$("$root/.agent/bin/worker-policy" "$role" model)"
  effort="$("$root/.agent/bin/worker-policy" "$role" reasoning_effort)"

  env \
    PATH="$test_path" \
    CODEX_WORKER_TEST_ROOT="$root" \
    CODEX_WORKER_TEST_CAPTURE="$capture" \
    CODEX_WORKER_TEST_DIRTY=none \
    CODEX_WORKER_TEST_CHILD_STATUS=0 \
    "$launcher" "$role" "$output" "$schema" </dev/null \
    >"$test_dir/route-$role.stdout" \
    2>"$test_dir/route-$role.stderr"

  assert_line "$capture" "model=$model"
  assert_line "$capture" "reasoning=model_reasoning_effort=\"$effort\""
  assert_line "$capture" "approval=never"
  assert_line "$capture" "exec=true"
  assert_line "$capture" "ephemeral=true"
  assert_line "$capture" "sandbox=workspace-write"
  assert_line "$capture" "output=$output"
  assert_line "$capture" "schema=$schema"
  assert_line "$capture" "stdin=true"
}

run_review_case clean-success none 0 0
run_review_case clean-failure none 29 29
run_review_case ignored-success ignored 0 0
run_review_case tracked-success tracked 0 4
run_review_case tracked-failure tracked 37 37
run_review_case cached-success cached 0 4
run_review_case untracked-success untracked 0 4
run_review_case committed-success committed 0 4

run_route_case apply
run_route_case review
run_route_case remediate
run_route_case finalize

set +e
env PATH="$test_path" "$launcher" invalid "$test_dir/invalid.json" \
  </dev/null >"$test_dir/invalid.stdout" 2>"$test_dir/invalid.stderr"
invalid_status=$?
set -e

[[ "$invalid_status" -eq 2 ]] ||
  fail "invalid role returned $invalid_status, expected 2"
grep -Fq "Unknown worker role: invalid" "$test_dir/invalid.stderr" ||
  fail "invalid role diagnostic was omitted"

final_status="$(git -C "$root" status --porcelain=v1 --untracked-files=all)"
final_tree="$(git -C "$root" write-tree)"
final_worktrees="$(git -C "$root" worktree list --porcelain)"

[[ "$final_status" == "$initial_status" ]] ||
  fail "the main repository status changed during the test"
[[ "$final_tree" == "$initial_tree" ]] ||
  fail "the main staged tree changed during the test"
[[ "$final_worktrees" == "$initial_worktrees" ]] ||
  fail "temporary review worktrees were not fully removed"

echo "codex-worker regression tests passed"
