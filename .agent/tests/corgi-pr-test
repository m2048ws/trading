HEAD = "1" * 40


def config(root: pathlib.Path, *, enabled: bool = True) -> object:
    binary = root / "tools/corgi/node_modules/.bin/corgispec"
    binary.parent.mkdir(parents=True)
    binary.write_text("fixture")
    return corgi_pr.PilotConfig(
        path=root / "pilot.json",
        enabled=enabled,
        blocked_reason="qualification gate",
        corgi_version="4.0.0-rc2",
        corgi_binary=binary,
        corgi_integrity="sha512-fixture",
        repository="owner/repo",
        remote="origin",
        base_branch="main",
        branch_prefix="corgi/",
        worktree_root=root / ".worktrees",
        admitted_changes=frozenset({"demo-change"}),
        authority=corgi_pr.Authority(
            local_corgi_commits=True,
            fast_forward_wip_push=True,
            draft_pr_create_or_update=True,
            ready_for_review=False,
            request_reviewers=False,
            merge=False,
            remote_branch_delete=False,
            tag=False,
            publish=False,
            release=False,
        ),
    )


