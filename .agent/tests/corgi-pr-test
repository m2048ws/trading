SOURCE_ROOT = pathlib.Path(__file__).resolve().parents[2]
MODULE_PATH = SOURCE_ROOT / "tools" / "corgi" / "corgi_pr.py"
SPEC = importlib.util.spec_from_file_location("trading_corgi_pr", MODULE_PATH)
assert SPEC is not None and SPEC.loader is not None
corgi_pr = importlib.util.module_from_spec(SPEC)
sys.modules[SPEC.name] = corgi_pr
