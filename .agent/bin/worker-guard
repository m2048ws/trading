#!/usr/bin/env python3

import json
import pathlib
import sys

sys.dont_write_bytecode = True

from worker_guard import WriterBusy, WriterReservation


ROOT = pathlib.Path(__file__).resolve().parents[2]


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def main() -> None:
    if sys.argv[1:] != ["probe"]:
        fail("Usage: worker-guard probe", 2)

    reservation = WriterReservation(ROOT)
    try:
        reservation.acquire()
    except WriterBusy:
        print(json.dumps({"available": False, "target": str(ROOT)}))
        raise SystemExit(3)
    finally:
        reservation.close()
    print(json.dumps({"available": True, "target": str(ROOT)}))


if __name__ == "__main__":
    main()
