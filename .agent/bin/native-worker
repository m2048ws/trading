#!/usr/bin/env python3

from __future__ import annotations

import hashlib
import json
import pathlib
import re
import secrets
import subprocess
import sys
import time
import uuid
from typing import Any

sys.dont_write_bytecode = True

from worker_guard import WriterBusy, WriterReservation, append_trace


ROOT = pathlib.Path(__file__).resolve().parents[2]
REPORTS = ROOT / ".agent" / "reports"
POLICY = ROOT / ".agent" / "worker-roles.json"
IDENTITY = ROOT / ".agent" / "bin" / "repository-identity"
VALIDATOR = ROOT / ".agent" / "bin" / "validate-worker-report"
STATE = ROOT / ".agent" / "bin" / "steward-state"
ASSIGNED_PATH_FIELDS = {
    "prompt",
    "report",
    "schema",
    "manifest",
    "lease",
    "state",
    "diagnostics",
    "detail",
}

# The current repository/client boundary cannot keep the complete executable
# transition closure immutable after a workspace-writing subagent starts, and
# the broker-owned flock does not survive broker-process death. A primary
# worktree writer therefore cannot be launched natively. Keep this enforcement
# in executable code as well as role policy so a capability file cannot assert
# either missing authority into existence.
NATIVE_PRIMARY_WRITER_AVAILABLE = False
NATIVE_PRIMARY_WRITER_REASONS = (
    "protected_executable_trust_closure_unavailable",
    "crash_surviving_writer_reservation_unavailable",
)

# Production native launch scope is deliberately closed over the role name,
# not inferred from the workspace-controlled role policy. The broker loads this
# immutable set before any delegated worker can alter live policy or helpers.
# Adding another role requires a reviewed code change, not policy
# reclassification.
PRODUCTION_NATIVE_ROLE_ALLOWLIST = frozenset({"exploration"})
FORMAL_ROLE_NAMES = frozenset({"apply", "review", "remediate", "finalize"})


class BrokerError(Exception):
    def __init__(self, message: str, status: int = 4) -> None:
        super().__init__(message)
        self.status = status


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def run(*args: str, check: bool = True) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        cwd=ROOT,
        check=check,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def canonical_bytes(value: Any) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def digest_bytes(value: bytes) -> str:
    return f"sha256:{hashlib.sha256(value).hexdigest()}"


def digest_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return f"sha256:{digest.hexdigest()}"


def load_json(path: pathlib.Path, kind: str) -> Any:
    try:
        return json.loads(path.read_text())
    except Exception as exc:
        raise BrokerError(f"Invalid {kind} JSON: {exc}") from exc


def role_policy(role: str) -> dict[str, Any]:
    result = run(
        str(ROOT / ".agent" / "bin" / "worker-policy"), role, check=False
    )
    if result.returncode != 0:
        raise BrokerError(
            result.stderr.strip() or f"Unknown worker role: {role}", 2
        )
    value = json.loads(result.stdout)
    if not isinstance(value, dict):
        raise BrokerError(f"Invalid worker policy for role: {role}")
    return value


def load_capabilities(path: pathlib.Path) -> dict[str, Any]:
    value = load_json(path, "native capabilities")
    if not isinstance(value, dict):
        raise BrokerError("Native capabilities must be an object", 2)
    return value


def selection(role: str, capabilities: dict[str, Any]) -> dict[str, Any]:
    policy = role_policy(role)
    missing = [
        guard
        for guard in policy["required_native_guards"]
        if capabilities.get(guard) is not True
    ]
    writer_unavailable = (
        policy["mutation_class"] == "primary_worktree_writer"
        and not NATIVE_PRIMARY_WRITER_AVAILABLE
    )
    role_allowed = role in PRODUCTION_NATIVE_ROLE_ALLOWLIST
    formal_role_denied = role in FORMAL_ROLE_NAMES
    eligible = (
        role_allowed
        and not formal_role_denied
        and policy["native_eligible"]
        and not missing
        and not writer_unavailable
    )
    reasons: list[str] = []
    if not role_allowed:
        reasons.append("production_native_role_not_allowed")
    if formal_role_denied:
        reasons.append("formal_role_requires_script")
    if not policy["native_eligible"]:
        reasons.append("role_policy_requires_script")
    if writer_unavailable:
        reasons.extend(NATIVE_PRIMARY_WRITER_REASONS)
    reasons.extend(f"missing_guard:{guard}" for guard in missing)
    return {
        "role": role,
        "selected_backend": "native" if eligible else "script",
        "native_eligible": eligible,
        "reasons": reasons,
        "model": policy["model"],
        "reasoning_effort": policy["reasoning_effort"],
        "agent_profile": policy["agent_profile"],
        "mutation_class": policy["mutation_class"],
        "required_native_guards": policy["required_native_guards"],
        "required_script_guards": policy["required_script_guards"],
    }


def repository_identity() -> dict[str, str]:
    result = run(str(IDENTITY), check=False)
    if result.returncode != 0:
        raise BrokerError(
            result.stderr.strip() or "Unable to refresh repository identity"
        )
    value = json.loads(result.stdout)
    required = {"head", "staged_tree", "working_tree_fingerprint"}
    if not isinstance(value, dict) or set(value) != required:
        raise BrokerError("Repository identity helper returned an invalid product")
    return value


def report_path(prefix: str, suffix: str) -> pathlib.Path:
    return (REPORTS / f"{prefix}.{suffix}").resolve()


def evidence(path: pathlib.Path) -> dict[str, Any]:
    return {
        "path": str(path),
        "sha256": digest_file(path),
        "bytes": path.stat().st_size,
    }


def refresh_state() -> tuple[dict[str, Any], bool]:
    result = run(str(STATE), check=False)
    if result.returncode == 0:
        try:
            parsed = json.loads(result.stdout)
            if isinstance(parsed, dict):
                return parsed, True
            error = "steward-state JSON root is not an object"
        except Exception as exc:
            error = f"steward-state returned invalid JSON: {exc}"
    else:
        error = f"steward-state exited {result.returncode}"
    return {
        "command_passed": False,
        "error": error,
        "stdout": result.stdout,
        "stderr": result.stderr,
    }, False


def compact_repository(state: dict[str, Any]) -> dict[str, Any]:
    git = state.get("git") if isinstance(state, dict) else None
    status = git.get("status") if isinstance(git, dict) else None
    if not isinstance(status, dict):
        return {"available": False}
    return {
        "available": True,
        "clean_worktree": status.get("clean_worktree"),
        "staged_count": status.get("staged_count"),
        "unstaged_count": status.get("unstaged_count"),
        "untracked_count": status.get("untracked_count"),
    }


def compact_openspec(state: dict[str, Any], change: str) -> dict[str, Any]:
    openspec = state.get("openspec") if isinstance(state, dict) else None
    active = openspec.get("active_changes") if isinstance(openspec, dict) else None
    if not isinstance(active, list):
        return {"available": False, "change": change}
    selected = next(
        (
            item
            for item in active
            if isinstance(item, dict) and item.get("name") == change
        ),
        None,
    )
    return {
        "available": selected is not None,
        "change": change,
        "active_change_count": openspec.get("active_change_count"),
    }


class AuthorityBroker:
    def __init__(self, capabilities: dict[str, Any]) -> None:
        self.capabilities = capabilities
        self.broker_id = uuid.uuid4().hex
        self.generation = 0
        self.active: dict[str, Any] | None = None
        self.consumed: set[tuple[str, int]] = set()

    def identity(self, active: dict[str, Any]) -> dict[str, Any]:
        return {
            "backend": "native",
            "role": active["role"],
            "change": active["change"],
            "mutation_class": active["mutation_class"],
            "launch_id": active["launch_id"],
            "generation": active["generation"],
        }

    def require_request(self, request: dict[str, Any]) -> dict[str, Any]:
        if "capability" in request:
            raise BrokerError(
                "Externally supplied capability does not match protected broker authority"
            )
        active = self.active
        launch_id = request.get("launch_id")
        generation = request.get("generation")
        if not isinstance(launch_id, str) or not isinstance(generation, int):
            raise BrokerError("launch_id and generation are required", 2)
        if (launch_id, generation) in self.consumed:
            raise BrokerError("Launch authority was already consumed or replayed")
        if active is None:
            raise BrokerError("No native launch is active")
        if launch_id != active["launch_id"] or generation != active["generation"]:
            raise BrokerError("Launch generation or launch id does not match active authority")
        capability = active.get("capability")
        if not isinstance(capability, bytes) or len(capability) != 32:
            raise BrokerError("Protected one-shot capability state is unavailable")
        if active.get("capability_consumed") is not False:
            raise BrokerError("One-shot capability is unavailable or consumed")
        return active

    def prepare(self, request: dict[str, Any]) -> dict[str, Any]:
        if self.active is not None:
            raise BrokerError("A native launch is already active")
        role = request.get("role")
        change = request.get("change")
        context_raw = request.get("context_file")
        if not isinstance(role, str) or not isinstance(change, str) or not change:
            raise BrokerError("prepare requires non-empty role and change", 2)
        # This second role-name gate intentionally does not consult role policy
        # or any live helper. Even if selection metadata is reclassified after
        # broker start, formal preparation creates no handoff artifacts,
        # reservation, active authority, transition authority, or fallback
        # authority.
        if role in FORMAL_ROLE_NAMES:
            return {
                "prepared": False,
                "role": role,
                "selected_backend": "script",
                "native_eligible": False,
                "reasons": [
                    "production_native_role_not_allowed",
                    "formal_role_requires_script",
                ],
            }
        if not isinstance(context_raw, str):
            raise BrokerError("prepare requires context_file", 2)
        context_path = pathlib.Path(context_raw).resolve()
        if not context_path.is_file():
            raise BrokerError(f"Missing context file: {context_path}", 2)
        selected = selection(role, self.capabilities)
        if selected["selected_backend"] != "native":
            return {"prepared": False, **selected}
        policy = role_policy(role)
        if not policy["formal"]:
            raise BrokerError(
                "Bounded exploration uses its assigned task directly, not a formal prompt"
            )

        REPORTS.mkdir(parents=True, exist_ok=True)
        self.generation += 1
        generation = self.generation
        launch_id = uuid.uuid4().hex
        prefix = f"{change}-{role}-{launch_id}"
        paths = {
            "prompt": str(report_path(prefix, "prompt.md")),
            "report": str(report_path(prefix, "report.json")),
            "schema": str((ROOT / policy["report_schema"]).resolve()),
            "manifest": str(report_path(prefix, "launch.json")),
            "lease": str(report_path(prefix, "lease.json")),
            "state": str(report_path(prefix, "state.json")),
            "diagnostics": str(report_path(prefix, "diagnostics.json")),
            "detail": str(report_path(prefix, "detail.json")),
        }
        prompt_file = pathlib.Path(paths["prompt"])
        schema_file = pathlib.Path(paths["schema"])
        manifest_file = pathlib.Path(paths["manifest"])
        lease_file = pathlib.Path(paths["lease"])
        rendered = run(
            str(ROOT / ".agent" / "bin" / "render-prompt"),
            str(ROOT / policy["prompt_template"]),
            str(context_path),
            change,
            check=False,
        )
        if rendered.returncode != 0:
            raise BrokerError(rendered.stderr.strip() or "Prompt rendering failed")
        handoff = f"""

---

# Native Structured Report Handoff

Read and execute this complete rendered prompt. Before returning, write one
complete JSON object satisfying the assigned schema to the assigned report
file. The report is the worker's only transition input; prose cannot replace it.

Assigned report file:

```text
{paths['report']}
```

Required JSON schema:

```text
{paths['schema']}
```
"""
        prompt_file.write_text(rendered.stdout + handoff)
        initial = repository_identity()
        lease = {
            "schema_version": 2,
            "backend": "native",
            "role": role,
            "change": change,
            "mutation_class": policy["mutation_class"],
            "launch_id": launch_id,
            "generation": generation,
            "broker_id": self.broker_id,
        }
        lease_file.write_text(json.dumps(lease, indent=2, sort_keys=True) + "\n")
        manifest = {
            "schema_version": 2,
            "backend": "native",
            "role": role,
            "change": change,
            "mutation_class": policy["mutation_class"],
            "launch_id": launch_id,
            "generation": generation,
            "broker_id": self.broker_id,
            "assigned_paths": paths,
            "initial_repository": initial,
            "policy_sha256": digest_file(POLICY),
            "prompt_sha256": digest_file(prompt_file),
            "schema_sha256": digest_file(schema_file),
            "lease_sha256": digest_file(lease_file),
        }
        manifest_file.write_text(json.dumps(manifest, indent=2, sort_keys=True) + "\n")
        reservation: WriterReservation | None = None
        try:
            if policy["mutation_class"] == "primary_worktree_writer":
                reservation = WriterReservation(ROOT)
                reservation.acquire()
        except WriterBusy as exc:
            prompt_file.unlink(missing_ok=True)
            lease_file.unlink(missing_ok=True)
            manifest_file.unlink(missing_ok=True)
            raise BrokerError(str(exc), 3) from exc

        active = {
            "role": role,
            "change": change,
            "mutation_class": policy["mutation_class"],
            "launch_id": launch_id,
            "generation": generation,
            "assigned_paths": paths,
            "initial_repository": initial,
            "policy_sha256": manifest["policy_sha256"],
            "prompt_sha256": manifest["prompt_sha256"],
            "schema_sha256": manifest["schema_sha256"],
            "lease_sha256": manifest["lease_sha256"],
            "manifest_sha256": digest_file(manifest_file),
            "lease": lease,
            "capability": secrets.token_bytes(32),
            "capability_consumed": False,
            "reservation": reservation,
        }
        self.active = active
        append_trace("launch", self.identity(active))
        assignment = (
            "Read and execute the complete rendered worker prompt at "
            f"{paths['prompt']}. Write the required structured report to "
            f"{paths['report']}."
        )
        return {
            "prepared": True,
            "selected_backend": "native",
            "role": role,
            "change": change,
            "launch_id": launch_id,
            "generation": generation,
            "model": policy["model"],
            "reasoning_effort": policy["reasoning_effort"],
            "agent_profile": policy["agent_profile"],
            "fork_turns": "none",
            "manifest_file": paths["manifest"],
            "prompt_file": paths["prompt"],
            "report_file": paths["report"],
            "spawn_assignment": assignment,
        }

    def integrity_errors(self, active: dict[str, Any]) -> list[str]:
        errors: list[str] = []
        paths = active["assigned_paths"]
        if not isinstance(paths, dict) or set(paths) != ASSIGNED_PATH_FIELDS:
            return ["Broker-retained assigned paths are invalid"]
        checks = (
            (POLICY, active["policy_sha256"], "worker role policy"),
            (pathlib.Path(paths["prompt"]), active["prompt_sha256"], "rendered prompt"),
            (pathlib.Path(paths["schema"]), active["schema_sha256"], "role schema"),
            (pathlib.Path(paths["lease"]), active["lease_sha256"], "writer lease evidence"),
            (
                pathlib.Path(paths["manifest"]),
                active["manifest_sha256"],
                "launch manifest",
            ),
        )
        for path, expected, label in checks:
            try:
                actual = digest_file(path)
            except OSError:
                errors.append(f"{label} is missing")
                continue
            if actual != expected:
                errors.append(f"{label} changed after preparation")
        try:
            manifest = load_json(pathlib.Path(paths["manifest"]), "launch manifest")
            lease = load_json(pathlib.Path(paths["lease"]), "lease evidence")
        except BrokerError as exc:
            errors.append(str(exc))
            return errors
        if manifest.get("launch_id") != active["launch_id"]:
            errors.append("manifest launch id differs from protected broker state")
        if manifest.get("generation") != active["generation"]:
            errors.append("manifest generation differs from protected broker state")
        if manifest.get("assigned_paths") != paths:
            errors.append("manifest assigned paths differ from protected broker state")
        if manifest.get("initial_repository") != active["initial_repository"]:
            errors.append("manifest launch snapshot differs from protected broker state")
        if lease != active["lease"]:
            errors.append("lease evidence differs from protected broker state")
        return errors

    def persist(
        self,
        active: dict[str, Any],
        state: dict[str, Any],
        diagnostics: dict[str, Any],
        report: Any,
    ) -> dict[str, Any]:
        paths = active["assigned_paths"]
        state_path = pathlib.Path(paths["state"])
        diagnostics_path = pathlib.Path(paths["diagnostics"])
        detail_path = pathlib.Path(paths["detail"])
        state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n")
        diagnostics_path.write_text(
            json.dumps(diagnostics, indent=2, sort_keys=True) + "\n"
        )
        detail = {
            **self.identity(active),
            "report": report,
            "refreshed_state": state,
            "diagnostics": diagnostics,
        }
        detail_path.write_text(json.dumps(detail, indent=2, sort_keys=True) + "\n")
        report_path_value = pathlib.Path(paths["report"])
        return {
            "report": evidence(report_path_value)
            if report_path_value.is_file()
            else {"path": paths["report"], "present": False},
            "state": evidence(state_path),
            "diagnostics": evidence(diagnostics_path),
            "detail": evidence(detail_path),
        }

    def compact(
        self,
        active: dict[str, Any],
        state: dict[str, Any],
        artifacts: dict[str, Any],
    ) -> dict[str, Any]:
        current = repository_identity()
        return {
            **self.identity(active),
            "head": current["head"],
            "staged_tree": current["staged_tree"],
            "repository": compact_repository(state),
            "openspec": compact_openspec(state, active["change"]),
            "artifacts": artifacts,
        }

    def consume(self, active: dict[str, Any], event: str) -> None:
        if active.get("capability_consumed") is not False:
            raise BrokerError("One-shot capability was already consumed")
        active["capability_consumed"] = True
        active["capability"] = b""
        self.consumed.add((active["launch_id"], active["generation"]))
        reservation = active.get("reservation")
        if isinstance(reservation, WriterReservation):
            reservation.close()
        append_trace(event, self.identity(active))
        self.active = None

    def collect(self, request: dict[str, Any]) -> dict[str, Any]:
        active = self.require_request(request)
        errors = self.integrity_errors(active)
        paths = active["assigned_paths"]
        validation = run(
            str(VALIDATOR),
            active["role"],
            paths["report"],
            paths["schema"],
            active["change"],
            check=False,
        )
        state, state_valid = refresh_state()
        try:
            report: Any = json.loads(pathlib.Path(paths["report"]).read_text())
        except Exception:
            report = None
        if validation.returncode != 0:
            errors.append("assigned report failed schema, workflow, or change validation")
        if not state_valid:
            errors.append("refreshed steward state failed")
        valid = not errors
        diagnostics = {
            "integrity_valid": not self.integrity_errors(active),
            "report_valid": validation.returncode == 0,
            "state_refresh_valid": state_valid,
            "lease_retained": not valid
            and active["mutation_class"] == "primary_worktree_writer",
            "capability_consumed": False,
            "errors": errors,
            "validation_stdout": validation.stdout.splitlines(),
            "validation_stderr": validation.stderr.splitlines(),
        }
        artifacts = self.persist(active, state, diagnostics, report)
        result = {
            **self.compact(active, state, artifacts),
            "transition_authority": False,
            "integrity_valid": diagnostics["integrity_valid"],
            "report_valid": diagnostics["report_valid"],
            "state_refresh_valid": state_valid,
            "fallback_safe": False,
            "blind_fallback_forbidden": True,
        }
        if not valid:
            result["status"] = 3 if diagnostics["integrity_valid"] else 4
            return result
        self.consume(active, "report_validated")
        diagnostics["capability_consumed"] = True
        artifacts = self.persist(active, state, diagnostics, report)
        result.update(
            {
                "artifacts": artifacts,
                "transition_authority": True,
                "release_valid": True,
                "capability_consumed": True,
                "status": 0,
            }
        )
        return result

    def classify_failure(self, request: dict[str, Any]) -> dict[str, Any]:
        active = self.require_request(request)
        errors = self.integrity_errors(active)
        state, state_valid = refresh_state()
        current = repository_identity()
        unchanged = current == active["initial_repository"]
        if not state_valid:
            errors.append("refreshed steward state failed")
        diagnostics = {
            "integrity_valid": not self.integrity_errors(active),
            "state_refresh_valid": state_valid,
            "repository_identity_unchanged": unchanged,
            "lease_retained": True,
            "capability_consumed": False,
            "errors": errors,
        }
        artifacts = self.persist(active, state, diagnostics, None)
        result = {
            **self.compact(active, state, artifacts),
            "fallback_safe": False,
            "blind_fallback_forbidden": True,
            "integrity_valid": diagnostics["integrity_valid"],
            "state_refresh_valid": state_valid,
        }
        if errors:
            result.update({"classification": "integrity_invalid", "status": 4})
            return result
        classification = (
            "pre_work_infrastructure_failure"
            if unchanged
            else "post_mutation_state_requires_classification"
        )
        self.consume(active, classification)
        diagnostics["capability_consumed"] = True
        artifacts = self.persist(active, state, diagnostics, None)
        result.update(
            {
                "artifacts": artifacts,
                "classification": classification,
                "fallback_safe": unchanged,
                "blind_fallback_forbidden": not unchanged,
                "capability_consumed": True,
                "status": 0,
            }
        )
        return result

    def recover(self, request: dict[str, Any]) -> dict[str, Any]:
        active = self.require_request(request)
        reason = request.get("reason")
        if not isinstance(reason, str) or not reason.strip():
            raise BrokerError("Protected recovery requires a non-empty reason", 2)
        state, state_valid = refresh_state()
        current = repository_identity()
        diagnostics = {
            "protected_recovery": True,
            "reason": reason,
            "state_refresh_valid": state_valid,
            "repository_identity_unchanged": current == active["initial_repository"],
            "integrity_errors": self.integrity_errors(active),
            "capability_consumed": False,
        }
        artifacts = self.persist(active, state, diagnostics, None)
        result = {
            **self.compact(active, state, artifacts),
            "recovered": False,
            "transition_authority": False,
            "fallback_safe": False,
            "blind_fallback_forbidden": True,
        }
        if not state_valid:
            result["status"] = 4
            return result
        self.consume(active, "protected_recovery")
        diagnostics["capability_consumed"] = True
        artifacts = self.persist(active, state, diagnostics, None)
        result.update(
            {
                "recovered": True,
                "capability_consumed": True,
                "artifacts": artifacts,
                "status": 0,
            }
        )
        return result

    def handle(self, request: dict[str, Any]) -> dict[str, Any]:
        command = request.get("command")
        if command == "select":
            role = request.get("role")
            if not isinstance(role, str):
                raise BrokerError("select requires role", 2)
            return {"status": 0, **selection(role, self.capabilities)}
        if command == "prepare":
            result = self.prepare(request)
            return {"status": 0 if result.get("prepared") else 3, **result}
        if command == "collect":
            return self.collect(request)
        if command == "classify_failure":
            return self.classify_failure(request)
        if command == "recover":
            return self.recover(request)
        if command == "status":
            active = self.active
            return {
                "status": 0,
                "broker_id": self.broker_id,
                "active": self.identity(active) if active is not None else None,
                "consumed_generation_count": len(self.consumed),
            }
        if command == "shutdown":
            if self.active is not None:
                raise BrokerError("Cannot shut down while native authority is active")
            return {"status": 0, "shutdown": True}
        raise BrokerError("Unknown or worker-invocable broker command", 2)

    def serve(self) -> None:
        print(
            json.dumps(
                {
                    "status": 0,
                    "broker_ready": True,
                    "broker_id": self.broker_id,
                    "protocol": 1,
                },
                sort_keys=True,
            ),
            flush=True,
        )
        while True:
            raw = sys.stdin.readline()
            if raw == "":
                if self.active is None:
                    return
                append_trace("control_channel_lost", self.identity(self.active))
                print(
                    json.dumps(
                        {
                            "status": 4,
                            "control_channel_lost": True,
                            "writer_retained": True,
                            "transition_authority": False,
                            "fallback_safe": False,
                            "blind_fallback_forbidden": True,
                        },
                        sort_keys=True,
                    ),
                    flush=True,
                )
                while True:
                    time.sleep(3600)
            try:
                request = json.loads(raw)
                if not isinstance(request, dict):
                    raise BrokerError("Broker request must be an object", 2)
                response = self.handle(request)
            except BrokerError as exc:
                response = {
                    "status": exc.status,
                    "error": str(exc),
                    "transition_authority": False,
                    "fallback_safe": False,
                    "blind_fallback_forbidden": True,
                }
            except Exception as exc:
                response = {
                    "status": 4,
                    "error": f"Broker internal failure: {exc}",
                    "transition_authority": False,
                    "fallback_safe": False,
                    "blind_fallback_forbidden": True,
                }
            print(json.dumps(response, sort_keys=True), flush=True)
            if response.get("shutdown") is True:
                return


def main() -> None:
    if len(sys.argv) == 4 and sys.argv[1] == "select":
        try:
            result = selection(sys.argv[2], load_capabilities(pathlib.Path(sys.argv[3])))
        except BrokerError as exc:
            fail(str(exc), exc.status)
        print(json.dumps(result, indent=2, sort_keys=True))
        return
    if len(sys.argv) == 3 and sys.argv[1] == "broker":
        try:
            capabilities = load_capabilities(pathlib.Path(sys.argv[2]))
        except BrokerError as exc:
            fail(str(exc), exc.status)
        AuthorityBroker(capabilities).serve()
        return
    fail(
        "Usage: native-worker select <role> <capabilities-json>\n"
        "       native-worker broker <capabilities-json>\n"
        "Broker prepare, collect, classify_failure, and recover requests are "
        "accepted only over the broker's private stdin control channel.",
        2,
    )


if __name__ == "__main__":
    main()
