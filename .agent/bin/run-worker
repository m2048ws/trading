#!/usr/bin/env python3

from __future__ import annotations

import json
import pathlib
import subprocess
import sys
import tempfile
import uuid
from typing import Any

sys.dont_write_bytecode = True

from worker_guard import WriterBusy, WriterReservation, append_trace


ROOT = pathlib.Path(__file__).resolve().parents[2]


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def run(*args: str, **kwargs: Any) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        **kwargs,
    )


def policy_field(role: str, field: str) -> str:
    result = run(str(ROOT / ".agent" / "bin" / "worker-policy"), role, field)
    if result.returncode != 0:
        fail(result.stderr.strip() or f"Unknown worker role: {role}", 2)
    return result.stdout.strip()


def repository_identity() -> dict[str, str]:
    result = run(str(ROOT / ".agent" / "bin" / "repository-identity"))
    if result.returncode != 0:
        fail(result.stderr.strip() or "Unable to read repository identity")
    return json.loads(result.stdout)


def trace_identity(
    role: str,
    change: str,
    mutation_class: str,
    launch_id: str,
    report_file: pathlib.Path,
) -> dict[str, Any]:
    repository = repository_identity()
    return {
        "backend": "script",
        "role": role,
        "change": change,
        "mutation_class": mutation_class,
        "launch_id": launch_id,
        "generation": None,
        "report_path": str(report_file),
        "head": repository["head"],
        "staged_tree": repository["staged_tree"],
    }


def main() -> None:
    if not 3 <= len(sys.argv) - 1 <= 4:
        fail(
            "Usage: run-worker <apply|review|remediate|finalize> "
            "<change-name> <context-json> [report-file]",
            2,
        )
    role, change, context_raw = sys.argv[1:4]
    if role not in {"apply", "review", "remediate", "finalize"}:
        fail(f"Unknown worker role: {role}", 2)
    if policy_field(role, "formal") != "true":
        fail(f"Worker role is not supported by run-worker: {role}", 2)

    context_file = pathlib.Path(context_raw).resolve()
    if not context_file.is_file():
        fail(f"Missing context file: {context_file}")
    template = (ROOT / policy_field(role, "prompt_template")).resolve()
    schema = (ROOT / policy_field(role, "report_schema")).resolve()
    mutation_class = policy_field(role, "mutation_class")
    if not template.is_file():
        fail(f"Missing template: {template}")
    if not schema.is_file():
        fail(f"Missing schema: {schema}")

    launch_id = uuid.uuid4().hex
    if len(sys.argv) == 5:
        report_file = pathlib.Path(sys.argv[4]).resolve()
    else:
        report_file = (
            ROOT / ".agent" / "reports" / f"{change}-{role}-{launch_id}.json"
        ).resolve()
    report_file.parent.mkdir(parents=True, exist_ok=True)

    rendered = run(
        str(ROOT / ".agent" / "bin" / "render-prompt"),
        str(template),
        str(context_file),
        change,
    )
    if rendered.returncode != 0:
        fail(rendered.stderr.strip() or "Prompt rendering failed")

    identity = trace_identity(
        role, change, mutation_class, launch_id, report_file
    )
    reservation: WriterReservation | None = None
    if mutation_class == "primary_worktree_writer":
        reservation = WriterReservation(ROOT)
        try:
            reservation.acquire()
        except WriterBusy as exc:
            fail(str(exc), 6)
    append_trace("launch", identity)

    print("Launching worker", file=sys.stderr)
    print(f"  role:   {role}", file=sys.stderr)
    print(f"  change: {change}", file=sys.stderr)
    print(f"  report: {report_file}", file=sys.stderr)

    review_tree_before = (
        repository_identity()["staged_tree"] if role == "review" else None
    )
    event = "interrupted"
    try:
        worker = run(
            str(ROOT / ".agent" / "bin" / "codex-worker"),
            role,
            str(report_file),
            str(schema),
            input=rendered.stdout,
            close_fds=True,
        )
        sys.stdout.write(worker.stdout)
        sys.stderr.write(worker.stderr)
        if worker.returncode != 0:
            event = "worker_failed"
            raise SystemExit(worker.returncode)

        validation = run(
            str(ROOT / ".agent" / "bin" / "validate-worker-report"),
            role,
            str(report_file),
            str(schema),
            change,
        )
        if validation.returncode != 0:
            sys.stdout.write(validation.stdout)
            sys.stderr.write(validation.stderr)
            print("\nWorker produced an invalid structured report:", file=sys.stderr)
            print(f"  {report_file}", file=sys.stderr)
            event = "report_rejected"
            raise SystemExit(3)

        if role == "review":
            review_tree_after = repository_identity()["staged_tree"]
            if review_tree_after != review_tree_before:
                print(
                    "Independent review approval is stale: staged tree changed",
                    file=sys.stderr,
                )
                event = "staged_tree_changed"
                raise SystemExit(5)

        event = "report_validated"
        print("\nWorker report:", file=sys.stderr)
        print(f"  {report_file}", file=sys.stderr)
        sys.stdout.write(report_file.read_text())
    finally:
        if reservation is not None:
            reservation.close()
        append_trace(event, identity)


if __name__ == "__main__":
    main()
