#!/usr/bin/env python3

import json
import pathlib
import sys
from typing import Any


ROOT = pathlib.Path(__file__).resolve().parents[2]
POLICY_PATH = ROOT / ".agent" / "worker-roles.json"


def fail(message: str, status: int = 1) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(status)


def load_policy() -> dict[str, Any]:
    try:
        policy = json.loads(POLICY_PATH.read_text())
    except Exception as exc:
        fail(f"Invalid worker role policy: {exc}")

    if policy.get("schema_version") != 2:
        fail("Unsupported worker role policy schema_version")

    roles = policy.get("roles")
    if not isinstance(roles, dict) or not roles:
        fail("Worker role policy must define roles")

    required = {
        "formal",
        "model",
        "reasoning_effort",
        "mutation_class",
        "native_eligible",
        "preferred_backend",
        "agent_profile",
        "prompt_template",
        "report_schema",
        "required_native_guards",
        "required_script_guards",
    }

    for name, role in roles.items():
        if not isinstance(role, dict):
            fail(f"Role {name} must be an object")

        missing = sorted(required - role.keys())
        if missing:
            fail(f"Role {name} is missing fields: {', '.join(missing)}")

        if role["preferred_backend"] not in {"native", "script"}:
            fail(f"Role {name} has an invalid preferred_backend")

        if role["mutation_class"] not in {
            "read_only",
            "primary_worktree_writer",
            "isolated_snapshot_reviewer",
        }:
            fail(f"Role {name} has an invalid mutation_class")

        for field in ("required_native_guards", "required_script_guards"):
            guards = role[field]
            if not isinstance(guards, list) or not all(
                isinstance(item, str) and item for item in guards
            ):
                fail(f"Role {name} has invalid {field}")

        if role["formal"]:
            for field in ("prompt_template", "report_schema"):
                value = role[field]
                if not isinstance(value, str) or not value:
                    fail(f"Formal role {name} requires {field}")
                if not (ROOT / value).is_file():
                    fail(f"Role {name} references missing {field}: {value}")

        if role["mutation_class"] == "primary_worktree_writer":
            if role["native_eligible"] is not False:
                fail(
                    f"Native primary-worktree writer role {name} must remain "
                    "ineligible until the executable trust closure is protected "
                    "and writer exclusion survives broker death"
                )
            if role["preferred_backend"] != "script":
                fail(
                    f"Primary-worktree writer role {name} must prefer the script "
                    "backend while native writer authority is unavailable"
                )
            broker_guards = {
                "steward_private_control_channel",
                "protected_broker_state",
                "monotonic_launch_generation",
                "one_shot_capability",
                "broker_owned_writer_lease",
            }
            missing_broker_guards = sorted(
                broker_guards - set(role["required_native_guards"])
            )
            if missing_broker_guards:
                fail(
                    f"Native writer role {name} is missing protected broker guards: "
                    + ", ".join(missing_broker_guards)
                )

    return policy


def main() -> None:
    if len(sys.argv) > 3:
        fail("Usage: worker-policy [role [field]]", 2)

    policy = load_policy()

    if len(sys.argv) == 1:
        value: Any = policy
    else:
        role_name = sys.argv[1]
        roles = policy["roles"]
        if role_name not in roles:
            fail(f"Unknown worker role: {role_name}", 2)
        value = roles[role_name]

        if len(sys.argv) == 3:
            field = sys.argv[2]
            if field not in value:
                fail(f"Unknown worker role field: {field}", 2)
            value = value[field]

    if isinstance(value, str):
        print(value)
    elif value is None:
        print("null")
    elif isinstance(value, bool):
        print("true" if value else "false")
    else:
        json.dump(value, sys.stdout, indent=2, sort_keys=True)
        sys.stdout.write("\n")


if __name__ == "__main__":
    main()
