#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  codex-worker <role> <output-file> [schema-file] [review-revision]

Roles:
  apply
  review
  remediate
  finalize

The fully rendered worker prompt is read from stdin.
review-revision is accepted only for the review role and selects an exact
committed PR-head tree instead of the legacy staged snapshot.
EOF
  exit 2
}

[[ $# -ge 2 && $# -le 4 ]] || usage

role="$1"
output_file="$2"
schema_file="${3:-}"
review_revision="${4:-}"
root="$(git rev-parse --show-toplevel)"
model="$("$root/.agent/bin/worker-policy" "$role" model)" || usage
reasoning_effort="$(
  "$root/.agent/bin/worker-policy" "$role" reasoning_effort
)" || usage
formal="$("$root/.agent/bin/worker-policy" "$role" formal)" || usage

[[ "$formal" == true ]] || {
  echo "Worker role is not supported by the script launcher: $role" >&2
  usage
}

mkdir -p "$(dirname "$output_file")"

codex_args_for() {
  local workdir="$1"

  CODEX_ARGS=(
    -m "$model"
    -c "model_reasoning_effort=\"$reasoning_effort\""
    --ask-for-approval never
    exec
    --ephemeral
    -C "$workdir"
    --sandbox workspace-write
    --output-last-message "$output_file"
  )

  if [[ -n "$schema_file" ]]; then
    CODEX_ARGS+=(--output-schema "$schema_file")
  fi

  CODEX_ARGS+=(-)
}

if [[ "$role" != "review" ]]; then
  [[ -z "$review_revision" ]] || usage
  codex_args_for "$root"
  exec codex "${CODEX_ARGS[@]}"
fi

if [[ -n "$review_revision" ]]; then
  snapshot="$(git -C "$root" rev-parse --verify "${review_revision}^{commit}")"
  [[ "$snapshot" == "$review_revision" ]] || {
    echo "Exact review revision must be a full commit id" >&2
    exit 2
  }
else
  tree="$(git -C "$root" write-tree)"

  snapshot="$(
    printf '%s\n' "temporary independent review snapshot" |
      git -C "$root" commit-tree "$tree" -p "$(git -C "$root" rev-parse HEAD)"
  )"
fi

review_dir="$(mktemp -d "${TMPDIR:-/tmp}/trading-review.XXXXXX")"

cleanup() {
  git -C "$root" worktree remove --force "$review_dir" >/dev/null 2>&1 || true
  rm -rf "$review_dir" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

git -C "$root" worktree add --detach "$review_dir" "$snapshot" >/dev/null

snapshot_head="$(git -C "$review_dir" rev-parse HEAD)"
snapshot_tree="$(git -C "$review_dir" rev-parse 'HEAD^{tree}')"

codex_args_for "$review_dir"

set +e
codex "${CODEX_ARGS[@]}"
status=$?
set -e

# The reviewer may create ignored build products, but it may not alter tracked
# repository state or leave non-ignored untracked files in the review snapshot.
after_status="$(
  git -C "$review_dir" status \
    --porcelain=v1 \
    --untracked-files=all
)"
after_head="$(git -C "$review_dir" rev-parse HEAD)"
after_tree="$(git -C "$review_dir" rev-parse 'HEAD^{tree}')"

snapshot_clean=true

if [[ "$after_head" != "$snapshot_head" || \
  "$after_tree" != "$snapshot_tree" || \
  -n "$after_status" ]]
then
  snapshot_clean=false

  echo >&2
  echo "Independent review modified its isolated review worktree:" >&2

  if [[ "$after_head" != "$snapshot_head" ]]; then
    printf 'Detached HEAD: expected %s, found %s\n' \
      "$snapshot_head" "$after_head" >&2
  fi

  if [[ "$after_tree" != "$snapshot_tree" ]]; then
    printf 'Detached tree: expected %s, found %s\n' \
      "$snapshot_tree" "$after_tree" >&2
  fi

  if [[ -n "$after_status" ]]; then
    printf '%s\n' "$after_status" >&2
  fi

  echo >&2
  echo "Tracked diff:" >&2
  git -C "$review_dir" diff -- >&2 || true

  echo >&2
  echo "Cached diff:" >&2
  git -C "$review_dir" diff --cached -- >&2 || true

  echo >&2
  echo "Non-ignored untracked files:" >&2
  git -C "$review_dir" ls-files \
    --others \
    --exclude-standard >&2 || true
fi

cleanup
trap - EXIT INT TERM

if [[ "$snapshot_clean" == false && "$status" -eq 0 ]]; then
  status=4
fi

exit "$status"
