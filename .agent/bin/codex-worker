#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  codex-worker <role> <output-file> [schema-file]

Roles:
  apply
  review
  remediate
  finalize

The fully rendered worker prompt is read from stdin.
EOF
  exit 2
}

[[ $# -ge 2 && $# -le 3 ]] || usage

role="$1"
output_file="$2"
schema_file="${3:-}"

case "$role" in
  apply)
    model="gpt-5.6-sol"
    reasoning_effort="high"
    ;;

  review)
    model="gpt-5.6-sol"
    reasoning_effort="max"
    ;;

  remediate)
    model="gpt-5.6-sol"
    reasoning_effort="xhigh"
    ;;

  finalize)
    model="gpt-5.6-sol"
    reasoning_effort="medium"
    ;;

  *)
    echo "Unknown worker role: $role" >&2
    usage
    ;;
esac

root="$(git rev-parse --show-toplevel)"
mkdir -p "$(dirname "$output_file")"

codex_args_for() {
  local workdir="$1"

  CODEX_ARGS=(
    -m "$model"
    -c "model_reasoning_effort=\"$reasoning_effort\""
    --ask-for-approval never
    exec
    --ephemeral
    -C "$workdir"
    --sandbox workspace-write
    --output-last-message "$output_file"
  )

  if [[ -n "$schema_file" ]]; then
    CODEX_ARGS+=(--output-schema "$schema_file")
  fi

  CODEX_ARGS+=(-)
}

if [[ "$role" != "review" ]]; then
  codex_args_for "$root"
  exec codex "${CODEX_ARGS[@]}"
fi

tree="$(git -C "$root" write-tree)"

snapshot="$(
  printf '%s\n' "temporary independent review snapshot" |
    git -C "$root" commit-tree "$tree" -p "$(git -C "$root" rev-parse HEAD)"
)"

review_dir="$(mktemp -d "${TMPDIR:-/tmp}/trading-review.XXXXXX")"

cleanup() {
  git -C "$root" worktree remove --force "$review_dir" >/dev/null 2>&1 || true
  rm -rf "$review_dir" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

git -C "$root" worktree add --detach "$review_dir" "$snapshot" >/dev/null

codex_args_for "$review_dir"

set +e
codex "${CODEX_ARGS[@]}"
status=$?
set -e

# The reviewer may create ignored build products, but it may not alter tracked
# repository state or leave non-ignored untracked files in the review snapshot.
after_status="$(
  git -C "$review_dir" status \
    --porcelain=v1 \
    --untracked-files=all
)"

snapshot_clean=true

if [[ -n "$after_status" ]]; then
  snapshot_clean=false

  echo >&2
  echo "Independent review modified its staged-snapshot worktree:" >&2
  printf '%s\n' "$after_status" >&2

  echo >&2
  echo "Tracked diff:" >&2
  git -C "$review_dir" diff -- >&2 || true

  echo >&2
  echo "Cached diff:" >&2
  git -C "$review_dir" diff --cached -- >&2 || true

  echo >&2
  echo "Non-ignored untracked files:" >&2
  git -C "$review_dir" ls-files \
    --others \
    --exclude-standard >&2 || true
fi

cleanup
trap - EXIT INT TERM

if [[ "$snapshot_clean" == false && "$status" -eq 0 ]]; then
  status=4
fi

exit "$status"
