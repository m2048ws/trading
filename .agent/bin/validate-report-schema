#!/usr/bin/env python3

import json
import pathlib
import sys
from typing import Any


def usage() -> None:
    print(
        "Usage: validate-report-schema <schema-json> <report-json>",
        file=sys.stderr,
    )
    raise SystemExit(2)


if len(sys.argv) != 3:
    usage()


def load_json(path: pathlib.Path, kind: str) -> Any:
    try:
        return json.loads(path.read_text())
    except Exception as exc:
        print(f"Invalid {kind} JSON: {exc}", file=sys.stderr)
        raise SystemExit(1)


schema = load_json(pathlib.Path(sys.argv[1]), "schema")
report = load_json(pathlib.Path(sys.argv[2]), "report")
errors: list[str] = []


def type_matches(value: Any, expected: str) -> bool:
    if expected == "object":
        return isinstance(value, dict)
    if expected == "array":
        return isinstance(value, list)
    if expected == "string":
        return isinstance(value, str)
    if expected == "boolean":
        return isinstance(value, bool)
    if expected == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if expected == "number":
        return isinstance(value, (int, float)) and not isinstance(value, bool)
    if expected == "null":
        return value is None
    errors.append(f"schema uses unsupported type {expected!r}")
    return False


def validate(value: Any, rule: dict[str, Any], path: str) -> None:
    expected = rule.get("type")
    if expected is not None:
        allowed = expected if isinstance(expected, list) else [expected]
        if not any(type_matches(value, item) for item in allowed):
            errors.append(f"{path}: expected type {allowed}, got {type(value).__name__}")
            return

    if "enum" in rule and value not in rule["enum"]:
        errors.append(f"{path}: value is not in enum {rule['enum']}")

    if isinstance(value, dict):
        properties = rule.get("properties", {})
        required = rule.get("required", [])

        for field in required:
            if field not in value:
                errors.append(f"{path}: missing required property {field!r}")

        if rule.get("additionalProperties") is False:
            for field in value:
                if field not in properties:
                    errors.append(f"{path}: unexpected property {field!r}")

        for field, child in value.items():
            if field in properties:
                validate(child, properties[field], f"{path}.{field}")

    if isinstance(value, list) and "items" in rule:
        for index, child in enumerate(value):
            validate(child, rule["items"], f"{path}[{index}]")


if not isinstance(schema, dict):
    print("Schema root must be an object", file=sys.stderr)
    raise SystemExit(1)

validate(report, schema, "$")

if errors:
    print("INVALID REPORT SCHEMA", file=sys.stderr)
    for error in errors:
        print(f"- {error}", file=sys.stderr)
    raise SystemExit(1)

print("VALID REPORT SCHEMA")
