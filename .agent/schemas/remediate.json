{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "finding_results",
    "regressions",
    "validation",
    "openspec",
    "git",
    "design_conflict"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready_for_independent_review",
        "blocked",
        "design_conflict"
      ]
    },
    "summary": {
      "type": "string"
    },
    "finding_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reproduced_before",
          "closed_after",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "reproduced_before": {
            "type": "boolean"
          },
          "closed_after": {
            "type": "boolean"
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "regressions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_negative",
        "new_positive",
        "previous_obligations_preserved"
      ],
      "properties": {
        "new_negative": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_positive": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "previous_obligations_preserved": {
          "type": "boolean"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "summary"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "openspec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_status",
        "independent_review_incomplete",
        "archived"
      ],
      "properties": {
        "task_status": {
          "type": "string"
        },
        "independent_review_incomplete": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "staged",
        "unstaged",
        "untracked",
        "commit_created"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "unstaged": {
          "type": "boolean"
        },
        "untracked": {
          "type": "boolean"
        },
        "commit_created": {
          "type": "boolean"
        }
      }
    },
    "design_conflict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "question",
        "invariants",
        "decisions",
        "reason"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
