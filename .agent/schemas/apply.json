{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "implementation_claims",
    "validation",
    "openspec",
    "git",
    "design_conflict"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ready_for_independent_review",
        "blocked",
        "design_conflict"
      ]
    },
    "summary": {
      "type": "string"
    },
    "implementation_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "summary"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "openspec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change",
        "task_status",
        "independent_review_incomplete",
        "archived"
      ],
      "properties": {
        "change": {
          "type": "string"
        },
        "task_status": {
          "type": "string"
        },
        "independent_review_incomplete": {
          "type": "boolean"
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "head",
        "staged",
        "unstaged",
        "untracked",
        "commit_created"
      ],
      "properties": {
        "head": {
          "type": "string"
        },
        "staged": {
          "type": "boolean"
        },
        "unstaged": {
          "type": "boolean"
        },
        "untracked": {
          "type": "boolean"
        },
        "commit_created": {
          "type": "boolean"
        }
      }
    },
    "design_conflict": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "question",
        "invariants",
        "decisions",
        "reason"
      ],
      "properties": {
        "question": {
          "type": "string"
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
