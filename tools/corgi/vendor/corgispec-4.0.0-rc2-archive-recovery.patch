+export async function requestArchiveRepairV3(input: {
+  projectRoot: string;
+  changeName: string;
+  token: LifecycleTokenV3;
+  evidenceManifestHash: ArtifactHashV3;
+  reason: string;
+}, dependencies: LifecycleV3Dependencies = {}): Promise<{
+  state: RunStateV3;
+  rollback: PendingArchiveRollbackV3;
+}> {
+  const reason = input.reason.trim();
+  if (!reason) throw new LifecycleV3Error("RUN_ARCHIVE_REPAIR_REASON_REQUIRED", "archive repair requires a reason");
+  // Archive repair exists specifically to recover a planning defect discovered
+  // after Archive begin. Preserve the exact planning/source binding, but do not
+  // require the known-bad plan to pass current readiness before it can be
+  // rolled back into the formal repair lifecycle.
+  const context = await requireBoundState(input.projectRoot, input.changeName, input.token, dependencies);
+  if (context.state.phase !== "archiving" || context.state.archive?.localCompleted !== false) {
+    throw new LifecycleV3Error(
+      "RUN_ARCHIVE_REPAIR_INVALID",
+      "archive repair may be requested only before local archive closeout completes",
+    );
+  }
