+export interface PendingArchiveRollbackV3 {
+  removedEvidencePath: string;
+  removedJournalPath: string | null;
+}
+
+/**
+ * Roll back only the reproducible local artifacts from a failed, pre-move
+ * Archive attempt. Run Contract state is transitioned separately through the
+ * Loop store after this function proves that no durable closeout occurred.
+ */
+export function rollbackPendingArchiveCloseoutV3(input: {
+  projectRoot: string;
+  changeName: string;
+  state: RunStateV3;
+  evidenceManifestHash: ArtifactHashV3;
+}, dependencies: ArchiveCloseoutV3Dependencies = {}): PendingArchiveRollbackV3 {
+  const root = resolve(input.projectRoot);
+  const state = input.state;
+  if (state.phase !== "archiving" || !state.archive || state.archive.localCompleted) {
+    throw new ArchiveCloseoutV3Error(
+      "Pending Archive rollback requires an active intent before local closeout",
+      "ARCHIVE_ROLLBACK_NOT_PENDING",
+    );
+  }
+  if (!state.finalRevision) {
+    throw new ArchiveCloseoutV3Error("Pending Archive rollback requires a verified final revision", "ARCHIVE_FINAL_REVISION_CHANGED");
+  }
+
+  const runGit = dependencies.git ?? git;
+  if (runGit(root, ["rev-parse", "HEAD"]) !== state.finalRevision) {
+    throw new ArchiveCloseoutV3Error(
+      "Pending Archive rollback requires the verified final revision at HEAD",
+      "ARCHIVE_FINAL_REVISION_CHANGED",
+    );
+  }
+
+  const activeSource = resolve(root, state.contract.sourcePath);
+  const activeChangeRoot = dirname(dirname(activeSource));
+  const activeRelative = relative(root, activeChangeRoot).replace(/\\/gu, "/");
+  if (
+    !activeRelative
+    || activeRelative === ".."
+    || activeRelative.startsWith("../")
+    || isAbsolute(activeRelative)
+    || !existsSync(activeSource)
+  ) {
+    throw new ArchiveCloseoutV3Error("Active Change is unavailable for pending Archive rollback", "ARCHIVE_CHANGE_NOT_FOUND");
+  }
+  const active = loadChangeContract(activeChangeRoot, { required: true })!;
+  assertContractBinding(active, state);
+  assertChangeEvidence(activeChangeRoot, state, input.evidenceManifestHash);
+
+  if (findArchivedCandidates(activeChangeRoot, input.changeName, state).length > 0) {
+    throw new ArchiveCloseoutV3Error(
+      "Pending Archive rollback refuses an existing matching archive target",
+      "ARCHIVE_ROLLBACK_TARGET_EXISTS",
+    );
+  }
+
+  const evidencePath = resolve(activeChangeRoot, "evidence");
+  const evidenceRelative = relative(root, evidencePath).replace(/\\/gu, "/");
+  const trackedEvidence = runGit(root, ["ls-files", "-z", "--", evidenceRelative])
+    .split("\0").filter(Boolean);
+  if (trackedEvidence.length > 0) {
+    throw new ArchiveCloseoutV3Error(
+      "Pending Archive rollback refuses tracked Change evidence",
+      "ARCHIVE_ROLLBACK_EVIDENCE_TRACKED",
+    );
+  }
+  const dirty = gitDirtyPaths(root, runGit);
+  const unrelated = dirty.filter((path) => path !== evidenceRelative && !path.startsWith(`${evidenceRelative}/`));
+  if (unrelated.length > 0) {
+    throw new ArchiveCloseoutV3Error(
+      `Pending Archive rollback found unrelated dirty paths: ${unrelated.join(", ")}`,
+      "ARCHIVE_ROLLBACK_MIXED_DIRTY",
+    );
+  }
+
+  const journalPath = archiveJournalPath(root, state);
+  let removedJournalPath: string | null = null;
+  if (existsSync(journalPath)) {
+    const journal = loadArchiveJournal(journalPath, state);
+    if (journal.stage !== "pending") {
+      throw new ArchiveCloseoutV3Error(
+        "Pending Archive rollback refuses a sealed closeout journal",
+        "ARCHIVE_ROLLBACK_JOURNAL_SEALED",
+      );
+    }
+    if (journal.activeChangeDigest !== directoryDigest(activeChangeRoot)) {
+      throw new ArchiveCloseoutV3Error(
+        "Active Change differs from the pending Archive journal",
+        "ARCHIVE_DIGEST_CHANGED",
+      );
+    }
+    removedJournalPath = journalPath;
+  }
+
+  rmSync(evidencePath, { recursive: true, force: false });
+  if (gitDirtyPaths(root, runGit).length > 0) {
+    throw new ArchiveCloseoutV3Error(
+      "Pending Archive rollback did not restore a clean verified worktree",
+      "ARCHIVE_ROLLBACK_INCOMPLETE",
+    );
+  }
+  if (removedJournalPath) rmSync(removedJournalPath, { force: false });
+  return { removedEvidencePath: evidencePath, removedJournalPath };
+}
